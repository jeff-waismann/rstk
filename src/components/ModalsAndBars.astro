---
import type { SiteSettings } from '../utils/format';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const defaultWhatsappUrl = `https://wa.me/${settings.whatsappNumber}?text=${encodeURIComponent(
  settings.whatsappDefaultMessage
)}`;
---

<div class="selectionbar" id="selectionbar" hidden>
  <span><strong id="bar-count">0</strong> vinil(is) no seu pedido</span>
  <button class="primary" id="view-selection" type="button">Ver Pedido / Carrinho →</button>
</div>

<a
  class="whatsapp-floating"
  id="whatsapp-floating"
  href={defaultWhatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Consultar os discos selecionados no WhatsApp"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
    <path d="M20.7 11.6a8.7 8.7 0 0 1-12.9 7.7L3 20.7l1.3-4.6A8.7 8.7 0 1 1 20.7 11.6Z" />
    <path d="M8 7.5c.5-.4 1 .1 1.4 1.2.2.5-.4.9-.6 1.2.6 1.4 1.7 2.5 3.2 3.2.4-.3.8-1 1.3-.7 1 .4 1.7.8 1.5 1.5-.3 1.1-1.3 1.6-2.6 1.2-3.4-1.1-5.4-3.1-6-5.2-.3-1 .1-1.8 1-2.4Z" />
  </svg>
  <span>WhatsApp</span>
</a>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

<dialog id="detail" aria-labelledby="detail-title">
  <div id="detail-body"></div>
</dialog>

<dialog id="selection" class="selection-dialog" aria-labelledby="selection-title">
  <button class="close" id="close-selection" type="button" aria-label="Fechar seleção">×</button>
  <h2 id="selection-title">Seu Pedido</h2>
  <p class="copy-note">Revise os títulos e quantidades para encomendar via WhatsApp ou copiar a lista.</p>
  <ul class="selected-list" id="selected-list"></ul>
  <div id="cart-delivery-container" class="cart-delivery-box" hidden>
    <div class="cart-delivery-top">
      <label for="cart-delivery-select" class="cart-delivery-label">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:4px;" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        Endereço de Entrega
      </label>
      <a href="/cliente/pedidos?tab=conta" class="cart-delivery-manage-link" title="Cadastrar nova loja ou filial">
        + Gerenciar Lojas
      </a>
    </div>
    <select id="cart-delivery-select" class="cart-delivery-select" aria-label="Selecione a loja ou endereço de entrega"></select>
    <p id="cart-delivery-preview" class="cart-delivery-preview"></p>
  </div>
  <div class="actions">
    <a
      class="whatsapp-action"
      id="whatsapp-modal"
      href={defaultWhatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Finalizar no WhatsApp ↗
    </a>
    <button
      class="btn-copy-list"
      id="btn-copy-list"
      type="button"
    >
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span>Copiar Lista</span>
    </button>
    {/* Botão Enviar Pedido oculto temporariamente (preservado para reativação futura) */}
    <button
      class="btn-send-order"
      id="btn-submit-order"
      type="button"
      hidden
      aria-hidden="true"
      style="display: none !important;"
    >
      Enviar Pedido
    </button>
    <button class="text-button" id="empty-selection" type="button">Limpar Pedido</button>
  </div>
  <textarea
    id="copy-fallback"
    aria-label="Lista para copiar manualmente"
    hidden
    readonly
  ></textarea>
  <p class="copy-note">
    Esta seleção não envia um pedido nem garante reserva. Confirme valores, estoque e edição com a RSTK.
  </p>
</dialog>
