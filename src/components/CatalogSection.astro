---
import type { SiteSettings, VinylAlbum } from '../utils/format';

interface Props {
  settings: SiteSettings;
  products: VinylAlbum[];
  artists: string[];
  genres: string[];
}

const { settings, products, artists, genres } = Astro.props;
const sortedProducts = [...products].sort(
  (a, b) => a.artist.localeCompare(b.artist, 'pt-BR') || a.id - b.id
);
---

<section class="browse wrap" id="catalogo">
  <div class="browse-head">
    <div>
      <h2 id="browse-title">{settings.browseTitle}</h2>
      <p id="browse-subtitle">{settings.browseSubtitle}</p>
    </div>
    <button class="saved" id="saved-toggle" type="button" aria-pressed="false">
      🛒 Meu Pedido <span id="saved-count">0</span>
    </button>
  </div>

  <div class="controls">
    <label class="search" for="search">
      <span class="sr">Buscar artista ou álbum</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m16 16 5 5"></path>
      </svg>
      <input
        id="search"
        type="search"
        placeholder="Busque por artista ou álbum…"
        autocomplete="off"
      />
    </label>

    <label class="sr" for="artist">Filtrar por artista</label>
    <select id="artist">
      <option value="">Todos os artistas</option>
      {artists.map((artist) => (
        <option value={artist}>{artist}</option>
      ))}
    </select>

    <label class="sr" for="format">Filtrar por formato de álbum</label>
    <select id="format">
      <option value="">Todos os formatos</option>
      <option value="1">Álbum Simples</option>
      <option value="2">Álbum Duplo</option>
    </select>

    <label class="sr" for="sort">Ordenação</label>
    <select id="sort">
      <option value="artist">Artista: A → Z</option>
      <option value="title">Álbum: A → Z</option>
      <option value="new">Edição: mais recente</option>
      <option value="old">Edição: mais antiga</option>
    </select>
  </div>

  <div class="chips" id="genres" role="group" aria-label="Filtrar por gênero">
    <button class="chip active" type="button" data-genre="" aria-pressed="true">
      Todos os gêneros
    </button>
    {genres.map((genre) => (
      <button class="chip" type="button" data-genre={genre} aria-pressed="false">
        {genre}
      </button>
    ))}
  </div>

  <div class="result-row">
    <span id="result-count" role="status" aria-live="polite">
      {sortedProducts.length} de {sortedProducts.length} títulos
    </span>
    <button class="text-button" id="clear" type="button">Limpar filtros ↗</button>
  </div>

  <div class="grid" id="grid">
    {sortedProducts.map((album) => {
      const unitLabel = album.units === 1 ? 'Álbum Simples' : (album.units === 2 ? 'Álbum Duplo' : `${album.units} LPs`);
      const isSoldOut = !album.active || Math.max(0, Number(album.stock ?? 30)) === 0;
      return (
        <article class={`card ${isSoldOut ? 'sold-out' : ''}`} data-id={album.id}>
          <div class="art">
            <button
              class="art-open"
              type="button"
              data-detail={album.id}
              aria-label={`Ver detalhes de ${album.title}`}
            >
              <img
                src={album.cover}
                loading="lazy"
                decoding="async"
                width="600"
                height="600"
                alt={`Capa de ${album.title}, ${album.artist}`}
              />
            </button>
            <span class="lp">{unitLabel}</span>
            {isSoldOut && (
              <span class="ribbon-sold-out" aria-label="Esgotado">
                ESGOTADO
              </span>
            )}
          </div>
          <div class="card-info">
            <p class="artist">{album.artist}</p>
            <button class="title" type="button" data-detail={album.id}>
              {album.title}
            </button>
            <p class="genre">{album.genre}</p>
            <div class="card-bottom">
              <button class="detail-btn" type="button" data-detail={album.id}>
                Conheça o disco <span>↗</span>
              </button>
              <div class="card-order-controls">
                <div class="qty-control" role="group" aria-label="Quantidade">
                  <button type="button" class="qty-btn" data-qty-dec={album.id} aria-label="Diminuir quantidade">−</button>
                  <input
                    type="number"
                    class="qty-input"
                    data-qty-input={album.id}
                    min="1"
                    max="99"
                    value="1"
                    aria-label={`Quantidade de ${album.title}`}
                  />
                  <button type="button" class="qty-btn" data-qty-inc={album.id} aria-label="Aumentar quantidade">+</button>
                </div>
                <button
                  type="button"
                  class={`btn-add-cart ${isSoldOut ? 'disabled-sold-out' : ''}`}
                  data-add-cart={album.id}
                  aria-label={isSoldOut ? `Produto esgotado: ${album.title}` : `Adicionar ${album.title} ao pedido`}
                  title={isSoldOut ? 'Produto esgotado' : 'Adicionar ao pedido'}
                >
                  <svg class="cart-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="21" r="1.3"></circle>
                    <circle cx="20" cy="21" r="1.3"></circle>
                    <path d="M1 1h4l2.6 13a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6L23 6H6"></path>
                  </svg>
                  <span class="cart-plus-badge">+</span>
                </button>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
