---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteSettingsData from '../data/siteSettings.json';
import catalogData from '../data/catalog.json';
import type { SiteSettings, VinylAlbum } from '../utils/format';

const settings = {
  ...(siteSettingsData as SiteSettings),
  seoTitle: 'Página não encontrada • RSTK Atacado',
  seoDescription: 'A página solicitada não foi encontrada no catálogo RSTK Atacado.'
};
const products = (catalogData as VinylAlbum[]).filter((p) => p.active !== false);
---

<BaseLayout settings={settings} products={products} heroCovers={[]} canonicalPath="/404" noindex={true}>
  <Header settings={settings} />

  <main class="wrap" style="padding-top: 84px; padding-bottom: 96px; text-align: center;">
    <div class="eyebrow" style="justify-content: center;">Erro 404</div>
    <h1 style="margin: 16px auto;">Disco não encontrado</h1>
    <p style="color: var(--muted); max-width: 480px; margin: 0 auto 28px;">
      O endereço acessado não existe ou foi movido. Volte ao catálogo completo de vinis lacrados e importados.
    </p>
    <a class="primary" href="/" style="display: inline-flex; align-items: center; text-decoration: none;">
      Ir para o catálogo completo →
    </a>
  </main>

  <Footer settings={settings} />
</BaseLayout>
