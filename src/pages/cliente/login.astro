---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogData from '../../data/catalog.json';
import siteSettingsData from '../../data/siteSettings.json';
import type { SiteSettings, VinylAlbum } from '../../utils/format';

const allProducts = catalogData as VinylAlbum[];
const siteSettings = {
  ...(siteSettingsData as SiteSettings),
  seoTitle: 'Login do Lojista — RSTK Atacado',
  seoDescription: 'Acesse o portal exclusivo de pedidos da RSTK Atacado para acompanhar seus lotes de vinis importados e lançamentos em tempo real.'
};

const artists = [...new Set(allProducts.map((p) => p.artist))].sort((a, b) =>
  a.localeCompare(b, 'pt-BR')
);
---

<BaseLayout
  settings={siteSettings}
  products={allProducts}
  heroCovers={allProducts.slice(0, 3)}
  canonicalPath="/cliente/login"
>
  {/* Header com Logo RSTK, Menu para voltar e Tema */}
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/" aria-label="RSTK Atacado — início">
        <img
          id="brand-logo"
          src={siteSettings.logoUrl || '/assets/images/logo-rstk.webp'}
          alt={siteSettings.brandAlt || 'RSTK ATACADO'}
          width="205"
          height="88"
          fetchpriority="high"
        />
      </a>
      <div class="top-right">
        <a href="/" class="header-back-catalog">
          ← Voltar para o Catálogo
        </a>
      </div>
    </div>
  </header>

  {/* Faixa de Busca, Artistas, Formato e Ordenação */}
  <div class="filter-strip-wrap">
    <div class="wrap">
      <form class="controls" id="catalog-redirect-controls" action="/" method="GET">
        <label class="search" for="search">
          <span class="sr">Buscar artista ou álbum</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m16 16 5 5"></path>
          </svg>
          <input
            id="search"
            name="search"
            type="search"
            placeholder="Busque por artista ou álbum no catálogo…"
            autocomplete="off"
          />
        </label>

        <label class="sr" for="artist">Filtrar por artista</label>
        <select id="artist" name="artist" onchange="this.form.submit()">
          <option value="">Todos os artistas</option>
          {artists.map((artist) => (
            <option value={artist}>{artist}</option>
          ))}
        </select>

        <label class="sr" for="format">Filtrar por formato de álbum</label>
        <select id="format" name="format" onchange="this.form.submit()">
          <option value="">Todos os formatos</option>
          <option value="1">Álbum Simples</option>
          <option value="2">Álbum Duplo</option>
        </select>

        <label class="sr" for="sort">Ordenação</label>
        <select id="sort" name="sort" onchange="this.form.submit()">
          <option value="artist">Artista: A → Z</option>
          <option value="title">Título: A → Z</option>
          <option value="newest">Mais recentes</option>
        </select>

        <button type="submit" class="btn-search-redirect">
          Buscar no Catálogo →
        </button>
      </form>
    </div>
  </div>

  <main class="auth-page">
    <div class="auth-container">
      {/* 1. Cadastre sua Loja no Topo (1260px) */}
      <div class="top-register-banner">
        <div>
          <span class="badge-new">Novo por aqui?</span>
          <p class="top-register-title">Sua loja ainda não tem cadastro?</p>
          <p class="top-register-sub">Cadastre seu CNPJ para ter acesso aos preços especiais de atacado e controle total dos seus pedidos.</p>
        </div>
        <a href="/cliente/cadastro" class="btn-goto-register">
          Cadastre sua Loja →
        </a>
      </div>

      {/* Grid Principal de 1260px: Lado Esquerdo (Vantagens) e Lado Direito (Login) */}
      <div class="auth-layout-grid">
        {/* Coluna da Esquerda: Benefícios e Informações */}
        <div class="benefits-column">
          <div class="callout-benefits-card">
            <div class="benefits-header">
              <span class="callout-icon">💡</span>
              <div>
                <h2>Por que ter uma conta na RSTK?</h2>
                <p>Controle completo das compras da sua loja de discos com total transparência.</p>
              </div>
            </div>

            <ul class="benefits-list">
              <li>
                <div class="benefit-bullet">✓</div>
                <div>
                  <strong>Acompanhamento em Tempo Real</strong>
                  <p>Veja quando seu pedido for aprovado, separado e expedido pela equipe RSTK.</p>
                </div>
              </li>
              <li>
                <div class="benefit-bullet">✓</div>
                <div>
                  <strong>Avisos Automáticos de Estoque</strong>
                  <p>Receba alertas imediatos caso algum disco esgote ou a quantidade seja ajustada, com o novo valor total recalculado.</p>
                </div>
              </li>
              <li>
                <div class="benefit-bullet">✓</div>
                <div>
                  <strong>Histórico Unificado</strong>
                  <p>Todos os pedidos finalizados salvos no painel da sua empresa para consulta rápida e reordenação.</p>
                </div>
              </li>
              <li>
                <div class="benefit-bullet">✓</div>
                <div>
                  <strong>Flexibilidade Total</strong>
                  <p>Você pode continuar encomendando via WhatsApp quando quiser. Com a conta, seus pedidos ficam organizados e protegidos.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>

        {/* Coluna da Direita: Card de Login */}
        <div class="login-column">
          <div class="auth-card">
            <div class="auth-card-header">
              <div class="auth-icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <h1>Área do Cliente</h1>
              <p>Informe o CNPJ ou E-mail cadastrado e sua senha de acesso.</p>
            </div>

            <div id="auth-alert" class="alert-box" hidden></div>

            <form id="login-form" class="auth-form" novalidate>
              <div class="form-group">
                <label for="identifier">CNPJ ou E-mail do Responsável</label>
                <input
                  type="text"
                  id="identifier"
                  name="identifier"
                  placeholder="00.000.000/0001-00 ou seu@email.com"
                  required
                  autocomplete="username"
                />
              </div>

              <div class="form-group">
                <div class="label-row">
                  <label for="password">Senha de Acesso</label>
                </div>
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Sua senha de acesso"
                  required
                  autocomplete="current-password"
                />
              </div>

              {/* Cloudflare Turnstile */}
              <div class="turnstile-container">
                <div
                  class="cf-turnstile"
                  data-sitekey="0x4AAAAAADN7xiosBuzdsddL"
                  data-theme="auto"
                ></div>
              </div>

              <button type="submit" id="btn-submit" class="btn-primary-auth">
                <span>Entrar na Área do Cliente</span>
              </button>
            </form>

            {/* Esqueci minha senha embaixo */}
            <div class="auth-card-footer">
              <a href="/cliente/recuperar-senha" class="footer-link">
                Esqueci minha senha
              </a>
              <span class="sep">·</span>
              <a href="/" class="footer-link">
                ← Voltar ao Catálogo
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script is:inline>
    (function () {
      // Se já estiver logado, redireciona diretamente para o painel
      fetch('/api/client/me', { cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.loggedIn) {
            window.location.replace('/cliente/pedidos');
          }
        })
        .catch(function () {});

      var form = document.getElementById('login-form');
      var alertBox = document.getElementById('auth-alert');
      var btnSubmit = document.getElementById('btn-submit');
      var idInput = document.getElementById('identifier');

      // Máscara flexível de CNPJ caso o usuário digite apenas números
      idInput.addEventListener('input', function (e) {
        var v = e.target.value;
        if (!v.includes('@') && /^\d+$/.test(v.replace(/\D/g, ''))) {
          var d = v.replace(/\D/g, '').slice(0, 14);
          if (d.length > 2 && d.length <= 5) {
            e.target.value = d.replace(/^(\d{2})(\d+)/, '$1.$2');
          } else if (d.length > 5 && d.length <= 8) {
            e.target.value = d.replace(/^(\d{2})(\d{3})(\d+)/, '$1.$2.$3');
          } else if (d.length > 8 && d.length <= 12) {
            e.target.value = d.replace(/^(\d{2})(\d{3})(\d{3})(\d+)/, '$1.$2.$3/$4');
          } else if (d.length > 12) {
            e.target.value = d.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{1,2})/, '$1.$2.$3/$4-$5');
          }
        }
      });

      function showAlert(msg, isError) {
        if (!alertBox) return;
        alertBox.textContent = msg;
        alertBox.className = isError ? 'alert-box alert-error' : 'alert-box alert-success';
        alertBox.hidden = false;
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        alertBox.hidden = true;

        var identifier = (document.getElementById('identifier').value || '').trim();
        var password = (document.getElementById('password').value || '').trim();

        var turnstileInput = form.querySelector('[name="cf-turnstile-response"]');
        var turnstileToken = turnstileInput ? turnstileInput.value : '';

        if (!identifier || !password) {
          showAlert('Por favor, informe seu CNPJ ou E-mail e senha.', true);
          return;
        }

        if (!turnstileToken) {
          showAlert('Por favor, complete a verificação de segurança Turnstile.', true);
          return;
        }

        btnSubmit.disabled = true;
        btnSubmit.classList.add('loading');
        btnSubmit.innerHTML = '<span>Verificando credenciais...</span>';

        try {
          var res = await fetch('/api/client/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              identifier: identifier,
              password: password,
              turnstileToken: turnstileToken
            })
          });

          var data = await res.json();

          if (res.ok && data.success) {
            showAlert('Login realizado com sucesso! Redirecionando...', false);

            var params = new URLSearchParams(window.location.search);
            var hasCartItems = false;
            try {
              var saved = JSON.parse(localStorage.getItem('rstk-selection') || '[]');
              if (Array.isArray(saved) && saved.length > 0) hasCartItems = true;
            } catch (e) {}

            var dest = (params.get('from') === 'cart' || hasCartItems) ? '/?openCart=1' : '/cliente/pedidos';

            setTimeout(function () {
              window.location.replace(dest);
            }, 600);
          } else {
            showAlert(data.error || 'Credenciais inválidas.', true);
            btnSubmit.disabled = false;
            btnSubmit.classList.remove('loading');
            btnSubmit.innerHTML = '<span>Entrar na Área do Cliente</span>';
            if (window.turnstile) {
              window.turnstile.reset();
            }
          }
        } catch (err) {
          showAlert('Erro de conexão ao servidor. Tente novamente.', true);
          btnSubmit.disabled = false;
          btnSubmit.classList.remove('loading');
          btnSubmit.innerHTML = '<span>Entrar na Área do Cliente</span>';
          if (window.turnstile) {
            window.turnstile.reset();
          }
        }
      });
    })();
  </script>

  <style>
    /* Header & Filter Strip */
    .header-back-catalog {
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
      text-decoration: none;
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--panel2);
      transition: all 0.2s ease;
    }

    .header-back-catalog:hover {
      border-color: #0866c8;
      color: #0866c8;
    }

    .filter-strip-wrap {
      background: var(--panel);
      border-bottom: 1px solid var(--line);
      padding: 12px 0;
    }

    .filter-strip-wrap .controls {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-search-redirect {
      background: #0866c8;
      color: #ffffff;
      font-size: 12px;
      font-weight: 750;
      padding: 8px 16px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .btn-search-redirect:hover {
      background: #0652a1;
    }

    /* Container de 1260px */
    .auth-page {
      min-height: calc(100vh - 200px);
      padding: 36px 16px 80px;
      display: flex;
      justify-content: center;
      background: var(--bg);
    }

    .auth-container {
      width: 100%;
      max-width: 1260px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Cadastre sua Loja no Topo */
    .top-register-banner {
      background: linear-gradient(135deg, #006782 0%, #004d61 100%);
      color: #ffffff;
      padding: 22px 30px;
      border-radius: 14px;
      box-shadow: 0 4px 14px rgba(0, 103, 130, 0.2);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .badge-new {
      display: inline-block;
      background: #00C6F7;
      color: #0F172A;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 3px 8px;
      border-radius: 6px;
      margin-bottom: 6px;
    }

    .top-register-title {
      font-size: 17px;
      font-weight: 750;
      margin: 0;
      line-height: 1.3;
    }

    .top-register-sub {
      font-size: 13.5px;
      opacity: 0.9;
      margin: 4px 0 0;
      line-height: 1.4;
    }

    .btn-goto-register {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #0866c8 !important;
      color: #ffffff !important;
      border: 1px solid #0866c8 !important;
      font-size: 14px;
      font-weight: 750;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.2s ease;
      box-shadow: 0 3px 10px rgba(8, 102, 200, 0.35);
      white-space: nowrap;
    }

    .btn-goto-register:hover {
      background: #0652a1 !important;
      border-color: #0652a1 !important;
      color: #ffffff !important;
      transform: translateY(-1px);
    }

    /* Grid Layout de 1260px */
    .auth-layout-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 28px;
      align-items: start;
    }

    /* Card de Benefícios */
    .callout-benefits-card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .benefits-header {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    .benefits-header h2 {
      font-size: 20px;
      font-weight: 800;
      color: var(--ink);
      margin: 0 0 4px;
    }

    .benefits-header p {
      font-size: 13.5px;
      color: var(--muted);
      margin: 0;
      line-height: 1.4;
    }

    .callout-icon {
      font-size: 26px;
    }

    .benefits-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .benefits-list li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    .benefit-bullet {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(8, 102, 200, 0.15);
      color: #0866c8;
      font-weight: 800;
      font-size: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .benefits-list strong {
      font-size: 14px;
      color: var(--ink);
      display: block;
      margin-bottom: 2px;
    }

    .benefits-list p {
      font-size: 13px;
      color: var(--muted);
      margin: 0;
      line-height: 1.4;
    }

    /* Card de Login */
    .auth-card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .auth-card-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .auth-icon-circle {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(8, 102, 200, 0.12);
      color: #0866c8;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 14px;
    }

    .auth-card-header h1 {
      font-size: 22px;
      font-weight: 800;
      color: var(--ink);
      margin: 0 0 6px;
    }

    .auth-card-header p {
      font-size: 13px;
      color: var(--muted);
      margin: 0;
    }

    /* Alerts */
    .alert-box {
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .alert-error {
      background: #FEE2E2;
      color: #991B1B;
      border: 1px solid #F87171;
    }

    .alert-success {
      background: #DCFCE7;
      color: #166534;
      border: 1px solid #86EFAC;
    }

    /* Form */
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 12px;
      font-weight: 700;
      color: var(--ink);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-group input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--bg);
      color: var(--ink);
      font-size: 14px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      box-sizing: border-box;
    }

    .form-group input:focus {
      outline: none;
      border-color: #0866c8;
      box-shadow: 0 0 0 3px rgba(8, 102, 200, 0.2);
    }

    .turnstile-container {
      display: flex;
      justify-content: center;
      margin: 8px 0;
      min-height: 65px;
    }

    .btn-primary-auth {
      background: #0866c8 !important;
      color: #ffffff !important;
      border: 1px solid #0866c8 !important;
      padding: 14px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 750;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(8, 102, 200, 0.25);
    }

    .btn-primary-auth *,
    .btn-goto-register * {
      color: #ffffff !important;
    }

    .btn-primary-auth:hover {
      background: #0652a1 !important;
      border-color: #0652a1 !important;
      color: #ffffff !important;
      transform: translateY(-1px);
    }

    .btn-primary-auth:hover *,
    .btn-goto-register:hover * {
      color: #ffffff !important;
    }

    .btn-primary-auth:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      transform: none;
    }

    /* Esqueci minha senha */
    .auth-card-footer {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      font-size: 13px;
    }

    .footer-link {
      color: var(--muted);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }

    .footer-link:hover {
      color: #0866c8;
      text-decoration: underline;
    }

    .sep {
      color: var(--line);
    }

    @media (max-width: 900px) {
      .auth-layout-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .top-register-banner {
        flex-direction: column;
        align-items: flex-start;
      }
      .btn-goto-register {
        width: 100%;
        justify-content: center;
      }
      .callout-benefits-card,
      .auth-card {
        padding: 22px 18px;
      }
    }
  </style>
</BaseLayout>
