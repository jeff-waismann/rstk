---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogData from '../../data/catalog.json';
import siteSettingsData from '../../data/siteSettings.json';
import type { SiteSettings, VinylAlbum } from '../../utils/format';

const allProducts = catalogData as VinylAlbum[];
const siteSettings = {
  ...(siteSettingsData as SiteSettings),
  seoTitle: 'Recuperação de Senha — RSTK Atacado',
  seoDescription: 'Recupere sua senha de acesso à área da revenda RSTK Atacado.'
};
---

<BaseLayout
  settings={siteSettings}
  products={allProducts}
  heroCovers={allProducts.slice(0, 3)}
  canonicalPath="/cliente/recuperar-senha"
  noindex={true}
>
  <main class="forgot-page">
    <div class="forgot-card">
      <div id="forgot-alert" class="alert-box" hidden></div>

      {/* Formulário 1: Solicitar link de redefinição */}
      <div id="step-request">
        <div class="forgot-header">
          <div class="icon-circle">🔑</div>
          <h1>Recuperar Senha</h1>
          <p>Informe o CNPJ ou e-mail cadastrado na sua conta para receber as instruções de recuperação.</p>
        </div>

        <form id="form-forgot" class="forgot-form" novalidate>
          <div class="form-group">
            <label for="identifier">CNPJ ou E-mail da Conta</label>
            <input
              type="text"
              id="identifier"
              placeholder="00.000.000/0000-00 ou email@empresa.com"
              required
            />
          </div>

          <div class="turnstile-container">
            <div
              class="cf-turnstile"
              data-sitekey="0x4AAAAAADN7xiosBuzdsddL"
              data-theme="auto"
            ></div>
          </div>

          <button type="submit" id="btn-submit-forgot" class="btn-primary-forgot">
            <span>Enviar Link de Recuperação</span>
          </button>
        </form>
      </div>

      {/* Formulário 2: Redefinir senha com token */}
      <div id="step-reset" hidden>
        <div class="forgot-header">
          <div class="icon-circle">🔒</div>
          <h1>Definir Nova Senha</h1>
          <p>Digite e confirme a nova senha para a sua conta.</p>
        </div>

        <form id="form-reset" class="forgot-form" novalidate>
          <div class="form-group">
            <label for="newPassword">Nova Senha (Mínimo 6 caracteres)</label>
            <input
              type="password"
              id="newPassword"
              minlength="6"
              placeholder="Digite a nova senha"
              required
            />
          </div>

          <div class="form-group">
            <label for="newPasswordConfirm">Confirmar Nova Senha</label>
            <input
              type="password"
              id="newPasswordConfirm"
              minlength="6"
              placeholder="Repita a nova senha"
              required
            />
          </div>

          <div class="turnstile-container">
            <div
              class="cf-turnstile"
              data-sitekey="0x4AAAAAADN7xiosBuzdsddL"
              data-theme="auto"
            ></div>
          </div>

          <button type="submit" id="btn-submit-reset" class="btn-primary-forgot">
            <span>Salvar Nova Senha</span>
          </button>
        </form>
      </div>

      <div class="forgot-footer">
        <a href="/cliente/login" class="back-link">← Voltar para o Login</a>
      </div>
    </div>
  </main>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script is:inline>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var resetToken = params.get('token');

      var stepRequest = document.getElementById('step-request');
      var stepReset = document.getElementById('step-reset');
      var alertBox = document.getElementById('forgot-alert');

      if (resetToken) {
        stepRequest.hidden = true;
        stepReset.hidden = false;
      }

      function showAlert(msg, isError) {
        if (!alertBox) return;
        alertBox.textContent = msg;
        alertBox.className = isError ? 'alert-box alert-error' : 'alert-box alert-success';
        alertBox.hidden = false;
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // Step 1: Solicitar link
      var formForgot = document.getElementById('form-forgot');
      var btnForgot = document.getElementById('btn-submit-forgot');

      formForgot.addEventListener('submit', async function (e) {
        e.preventDefault();
        alertBox.hidden = true;

        var identifier = (document.getElementById('identifier').value || '').trim();
        var turnstileInput = formForgot.querySelector('[name="cf-turnstile-response"]');
        var turnstileToken = turnstileInput ? turnstileInput.value : '';

        if (!identifier) {
          showAlert('Informe seu CNPJ ou E-mail cadastrado.', true);
          return;
        }
        if (!turnstileToken) {
          showAlert('Por favor, complete a verificação Turnstile.', true);
          return;
        }

        btnForgot.disabled = true;
        btnForgot.innerHTML = '<span>Processando...</span>';

        try {
          var res = await fetch('/api/client/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ identifier: identifier, turnstileToken: turnstileToken })
          });
          var data = await res.json();
          if (res.ok && data.success) {
            showAlert(data.message || 'Se a conta existir, as instruções foram enviadas para seu e-mail.', false);
            formForgot.reset();
          } else {
            showAlert(data.error || 'Erro ao processar solicitação.', true);
          }
        } catch (err) {
          showAlert('Erro ao conectar ao servidor.', true);
        } finally {
          btnForgot.disabled = false;
          btnForgot.innerHTML = '<span>Enviar Link de Recuperação</span>';
          if (window.turnstile) window.turnstile.reset();
        }
      });

      // Step 2: Redefinir senha com token
      var formReset = document.getElementById('form-reset');
      var btnReset = document.getElementById('btn-submit-reset');

      formReset.addEventListener('submit', async function (e) {
        e.preventDefault();
        alertBox.hidden = true;

        var newPassword = (document.getElementById('newPassword').value || '').trim();
        var newPasswordConfirm = (document.getElementById('newPasswordConfirm').value || '').trim();
        var turnstileInput = formReset.querySelector('[name="cf-turnstile-response"]');
        var turnstileToken = turnstileInput ? turnstileInput.value : '';

        if (newPassword.length < 6) {
          showAlert('A senha deve ter no mínimo 6 caracteres.', true);
          return;
        }
        if (newPassword !== newPasswordConfirm) {
          showAlert('As senhas não coincidem.', true);
          return;
        }
        if (!turnstileToken) {
          showAlert('Por favor, complete a verificação Turnstile.', true);
          return;
        }

        btnReset.disabled = true;
        btnReset.innerHTML = '<span>Salvando nova senha...</span>';

        try {
          var res = await fetch('/api/client/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              token: resetToken,
              newPassword: newPassword,
              turnstileToken: turnstileToken
            })
          });
          var data = await res.json();
          if (res.ok && data.success) {
            showAlert('Senha alterada com sucesso! Redirecionando para o login...', false);
            setTimeout(function () {
              window.location.replace('/cliente/login');
            }, 1500);
          } else {
            showAlert(data.error || 'Erro ao redefinir senha.', true);
            btnReset.disabled = false;
            btnReset.innerHTML = '<span>Salvar Nova Senha</span>';
            if (window.turnstile) window.turnstile.reset();
          }
        } catch (err) {
          showAlert('Erro ao conectar ao servidor.', true);
          btnReset.disabled = false;
          btnReset.innerHTML = '<span>Salvar Nova Senha</span>';
          if (window.turnstile) window.turnstile.reset();
        }
      });
    })();
  </script>

  <style>
    .forgot-page {
      min-height: calc(100vh - 120px);
      padding: 50px 16px;
      display: flex;
      justify-content: center;
      background: var(--bg);
    }

    .forgot-card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 36px 28px;
      max-width: 460px;
      width: 100%;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .forgot-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .icon-circle {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(0, 198, 247, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      margin: 0 auto 12px;
    }

    .forgot-header h1 {
      font-size: 22px;
      font-weight: 800;
      color: var(--ink);
      margin: 0 0 6px;
    }

    .forgot-header p {
      font-size: 13.5px;
      color: var(--muted);
      margin: 0;
      line-height: 1.5;
    }

    .forgot-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 12px;
      font-weight: 700;
      color: var(--ink);
    }

    .form-group input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--bg);
      color: var(--ink);
      font-size: 14px;
      box-sizing: border-box;
    }

    .form-group input:focus {
      outline: none;
      border-color: #00C6F7;
      box-shadow: 0 0 0 3px rgba(0, 198, 247, 0.2);
    }

    .turnstile-container {
      display: flex;
      justify-content: center;
      min-height: 65px;
    }

    .btn-primary-forgot {
      background: var(--blue);
      color: #ffffff;
      border: none;
      padding: 13px 20px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 750;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-primary-forgot:hover {
      background: var(--blue-dark);
    }

    .btn-primary-forgot:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .forgot-footer {
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
      text-align: center;
    }

    .back-link {
      font-size: 13px;
      font-weight: 650;
      color: var(--muted);
      text-decoration: none;
    }

    .back-link:hover {
      color: var(--blue);
      text-decoration: underline;
    }

    .alert-box {
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .alert-error {
      background: #FEE2E2;
      color: #991B1B;
      border: 1px solid #F87171;
    }

    .alert-success {
      background: #DCFCE7;
      color: #166534;
      border: 1px solid #86EFAC;
    }
  </style>
</BaseLayout>
