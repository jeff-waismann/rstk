---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogData from '../../data/catalog.json';
import siteSettingsData from '../../data/siteSettings.json';
import type { SiteSettings, VinylAlbum } from '../../utils/format';

const allProducts = catalogData as VinylAlbum[];
const siteSettings = {
  ...(siteSettingsData as SiteSettings),
  seoTitle: 'Confirmação de Conta — RSTK Atacado',
  seoDescription: 'Confirmação de e-mail e validação de conta da revenda RSTK.'
};
---

<BaseLayout
  settings={siteSettings}
  products={allProducts}
  heroCovers={allProducts.slice(0, 3)}
  canonicalPath="/cliente/verificar"
  noindex={true}
>
  <main class="verify-page">
    <div class="verify-card">
      <div id="verify-loading" class="verify-state">
        <div class="spinner"></div>
        <h2>Validando sua conta...</h2>
        <p>Aguarde um momento enquanto confirmamos seu endereço de e-mail.</p>
      </div>

      <div id="verify-success" class="verify-state" hidden>
        <div class="icon-circle icon-success">✓</div>
        <h2>E-mail Confirmado com Sucesso!</h2>
        <p>Sua conta de revenda está 100% ativada. A partir de agora você receberá notificações automáticas sempre que seus pedidos forem aprovados ou atualizados.</p>
        <a href="/cliente/pedidos" class="btn-primary-verify">Acessar Minha Área de Pedidos →</a>
      </div>

      <div id="verify-error" class="verify-state" hidden>
        <div class="icon-circle icon-error">✕</div>
        <h2>Falha na Confirmação</h2>
        <p id="error-message">O token de confirmação é inválido ou já foi utilizado anteriormente.</p>
        <div class="verify-actions">
          <a href="/cliente/login" class="btn-primary-verify">Ir para a Tela de Login</a>
          <a href="/" class="btn-secondary-verify">Voltar ao Início</a>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      var loadingEl = document.getElementById('verify-loading');
      var successEl = document.getElementById('verify-success');
      var errorEl = document.getElementById('verify-error');
      var errorMsgEl = document.getElementById('error-message');

      var params = new URLSearchParams(window.location.search);
      var token = params.get('token');

      if (!token) {
        loadingEl.hidden = true;
        errorMsgEl.textContent = 'Nenhum código de confirmação foi encontrado no link.';
        errorEl.hidden = false;
        return;
      }

      fetch('/api/client/verify?token=' + encodeURIComponent(token), { method: 'POST' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          loadingEl.hidden = true;
          if (data && data.success) {
            successEl.hidden = false;
          } else {
            errorMsgEl.textContent = data.error || 'Token inválido ou expirado.';
            errorEl.hidden = false;
          }
        })
        .catch(function () {
          loadingEl.hidden = true;
          errorMsgEl.textContent = 'Erro ao conectar ao servidor. Tente novamente mais tarde.';
          errorEl.hidden = false;
        });
    })();
  </script>

  <style>
    .verify-page {
      min-height: calc(100vh - 120px);
      padding: 60px 16px;
      display: flex;
      justify-content: center;
      align-items: center;
      background: var(--bg);
    }

    .verify-card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 40px 32px;
      max-width: 500px;
      width: 100%;
      text-align: center;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .verify-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }

    .verify-state h2 {
      font-size: 20px;
      font-weight: 800;
      color: var(--ink);
      margin: 0;
    }

    .verify-state p {
      font-size: 14px;
      color: var(--muted);
      margin: 0;
      line-height: 1.5;
    }

    .icon-circle {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 6px;
    }

    .icon-success {
      background: #DCFCE7;
      color: #16A34A;
    }

    .icon-error {
      background: #FEE2E2;
      color: #DC2626;
    }

    .btn-primary-verify {
      display: inline-block;
      background: var(--blue);
      color: #ffffff;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 750;
      text-decoration: none;
      margin-top: 10px;
      box-shadow: 0 2px 8px rgba(0, 103, 130, 0.25);
    }

    .btn-primary-verify:hover {
      background: var(--blue-dark);
    }

    .btn-secondary-verify {
      display: inline-block;
      border: 1px solid var(--line);
      color: var(--ink);
      padding: 11px 20px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 650;
      text-decoration: none;
    }

    .verify-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 10px;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border: 3px solid var(--line);
      border-top-color: var(--blue);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 8px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</BaseLayout>
