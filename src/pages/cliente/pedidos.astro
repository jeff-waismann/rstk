---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogData from '../../data/catalog.json';
import siteSettingsData from '../../data/siteSettings.json';
import type { SiteSettings, VinylAlbum } from '../../utils/format';

const allProducts = catalogData as VinylAlbum[];
const siteSettings = {
  ...(siteSettingsData as SiteSettings),
  seoTitle: 'Meus Pedidos & Área do Cliente — RSTK Atacado',
  seoDescription: 'Acompanhe seus pedidos de vinis no atacado, status de aprovação e histórico de compras da sua loja.'
};
---

<BaseLayout
  settings={siteSettings}
  products={allProducts}
  heroCovers={allProducts.slice(0, 3)}
  canonicalPath="/cliente/pedidos"
  noindex={true}
>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/" aria-label="RSTK Atacado — início">
        <img
          id="brand-logo"
          src={siteSettings.logoUrl || '/assets/images/logo-rstk.webp'}
          alt={siteSettings.brandAlt || 'RSTK ATACADO'}
          width="205"
          height="88"
          fetchpriority="high"
        />
      </a>
      <div class="top-right">
        <a href="/" class="header-back-catalog">
          ← Voltar ao Catálogo
        </a>
        <div class="theme" role="group" aria-label="Tema de aparência">
          <button id="light" type="button" aria-pressed="true">☀ Claro</button>
          <button id="dark" type="button" aria-pressed="false">☾ Escuro</button>
        </div>
      </div>
    </div>
  </header>

  <main class="portal-page">
    <div class="portal-container">
      {/* Top Header do Portal do Cliente */}
      <div class="portal-header">
        <div class="portal-welcome">
          <span class="badge-b2b">Área da Loja / Revenda</span>
          <h1 id="client-company-name">Carregando seus dados...</h1>
          <p id="client-info-sub" class="client-sub">Consultando seus dados cadastrais...</p>
        </div>
        <div class="portal-header-actions">
          <a href="/" class="btn-new-order">
            <span>+ Novo Pedido no Catálogo</span>
          </a>
          <button type="button" id="btn-logout" class="btn-logout-portal">
            Sair da Conta
          </button>
        </div>
      </div>

      {/* Banner de Aviso: E-mail não confirmado */}
      <div id="unverified-banner" class="unverified-banner" hidden>
        <div class="unverified-left">
          <div class="unverified-icon">✉</div>
          <div class="unverified-content">
            <strong>Confirmação de e-mail pendente</strong>
            <p>Enviamos um link de confirmação para sua caixa de entrada. Você já pode enviar seus pedidos normalmente e confirmar o e-mail quando quiser.</p>
          </div>
        </div>
        <button type="button" id="btn-resend-verification" class="btn-resend-email">
          Reenviar E-mail
        </button>
      </div>

      {/* Banner de Pedido em Andamento no Carrinho */}
      <div id="pending-cart-banner" class="pending-cart-card" hidden>
        <div class="pending-cart-left">
          <span class="pending-cart-icon">🛒</span>
          <div>
            <strong id="pending-cart-title">Você possui itens no carrinho prontos para envio!</strong>
            <p>Seus vinis continuam salvos e você pode enviar seu pedido diretamente pela sua conta.</p>
          </div>
        </div>
        <a href="/?openCart=1" class="btn-finalize-pending">
          Revisar e Enviar Pedido →
        </a>
      </div>

      <div id="portal-alert" class="alert-box" hidden></div>

      {/* Seção Principal de Pedidos */}
      <div class="portal-content">
        <div class="orders-section-header">
          <div class="orders-title-group">
            <div class="orders-title-row">
              <h2>Histórico de Pedidos</h2>
              <span id="orders-count-badge" class="orders-count-badge">0 pedidos</span>
            </div>
            <p>Acompanhe o status de faturamento, aprovação e expedição dos pedidos da sua loja. Clique em qualquer pedido para ver os itens detalhados.</p>
          </div>
          <button type="button" id="btn-refresh-orders" class="btn-refresh">
            <span class="refresh-icon">↻</span>
            <span>Atualizar</span>
          </button>
        </div>

        <div id="orders-loading" class="orders-loading">
          <div class="spinner"></div>
          <p>Carregando histórico de pedidos da sua loja...</p>
        </div>

        <div id="orders-empty" class="orders-empty" hidden>
          <div class="empty-icon">📦</div>
          <h3>Nenhum pedido encontrado</h3>
          <p>Sua loja ainda não realizou pedidos vinculados a esta conta. Escolha seus vinis no catálogo e clique em "Enviar Pedido" para acompanhar tudo por aqui em tempo real!</p>
          <a href="/" class="btn-primary-portal">Explorar Catálogo de Vinis →</a>
        </div>

        <div id="orders-list" class="orders-list" hidden>
          {/* Inserido dinamicamente via JS como cards accordion */}
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      var clientData = null;
      var ordersData = [];
      var expandedOrderIds = {}; // Armazena quais pedidos estão abertos
      var alertBox = document.getElementById('portal-alert');
      var ordersContainer = document.getElementById('orders-list');
      var loadingEl = document.getElementById('orders-loading');
      var emptyEl = document.getElementById('orders-empty');
      var countBadgeEl = document.getElementById('orders-count-badge');
      var companyNameEl = document.getElementById('client-company-name');
      var infoSubEl = document.getElementById('client-info-sub');
      var unverifiedBanner = document.getElementById('unverified-banner');
      var btnLogout = document.getElementById('btn-logout');
      var btnRefresh = document.getElementById('btn-refresh-orders');

      function formatBRL(cents) {
        return ((cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      }

      function formatDateTimeBR(dateStr) {
        if (!dateStr) return '—';
        try {
          var clean = dateStr.replace(' ', 'T');
          if (!clean.includes('Z') && !clean.includes('+') && !clean.includes('-')) {
            clean += 'Z';
          }
          var d = new Date(clean);
          return d.toLocaleString('pt-BR', {
            timeZone: 'America/Sao_Paulo',
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
        } catch (e) {
          return dateStr;
        }
      }

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      var STATUS_MAP = {
        enviado: {
          label: 'Enviado / Em Análise',
          badgeClass: 'badge-status-enviado',
          icon: '📋',
          desc: 'Seu pedido foi registrado e está sendo conferido pela equipe RSTK.'
        },
        whatsapp_aberto: {
          label: 'Enviado / Em Análise',
          badgeClass: 'badge-status-enviado',
          icon: '📋',
          desc: 'Seu pedido foi registrado e está sendo conferido pela equipe RSTK.'
        },
        aprovado: {
          label: 'Aprovado pela RSTK',
          badgeClass: 'badge-status-aprovado',
          icon: '✓',
          desc: 'Pedido aprovado! Itens confirmados e em processo de separação.'
        },
        confirmado: {
          label: 'Aprovado pela RSTK',
          badgeClass: 'badge-status-aprovado',
          icon: '✓',
          desc: 'Pedido aprovado! Itens confirmados e em processo de separação.'
        },
        aprovado_com_alteracoes: {
          label: 'Aprovado com Alterações',
          badgeClass: 'badge-status-alteracoes',
          icon: '⚠️',
          desc: 'Houve alteração no estoque de alguns itens. Confira e aprove as alterações abaixo.'
        },
        alteracoes_aceitas: {
          label: 'Alterações Aprovadas',
          badgeClass: 'badge-status-aceito',
          icon: '✓',
          desc: 'Você aprovou as alterações! A equipe RSTK foi notificada para despachar.'
        },
        despachado: {
          label: 'Despachado / Enviado',
          badgeClass: 'badge-status-despachado',
          icon: '🚚',
          desc: 'Pedido despachado! Seus vinis estão a caminho da sua loja.'
        },
        cancelado: {
          label: 'Cancelado',
          badgeClass: 'badge-status-cancelado',
          icon: '✕',
          desc: 'Pedido cancelado.'
        }
      };

      async function checkAuth() {
        try {
          var res = await fetch('/api/client/me', { cache: 'no-store' });
          var data = await res.json();
          if (!res.ok || !data.loggedIn) {
            window.location.replace('/cliente/login');
            return;
          }
          clientData = data.client;
          renderClientHeader();
          loadOrders();
        } catch (err) {
          window.location.replace('/cliente/login');
        }
      }

      function renderClientHeader() {
        if (!clientData) return;
        var displayName = clientData.nomeFantasia || clientData.razaoSocial;
        companyNameEl.textContent = displayName;
        var isVerified = Boolean(clientData.emailVerified === true || clientData.emailVerified === 1 || clientData.emailVerified === '1');
        infoSubEl.textContent = 'CNPJ: ' + (clientData.cnpj || '—') + ' · Responsável: ' + (clientData.responsavelNome || '—') + ' (' + clientData.email + ')';

        if (!isVerified) {
          unverifiedBanner.hidden = false;
          unverifiedBanner.style.display = 'flex';
        } else {
          unverifiedBanner.hidden = true;
          unverifiedBanner.style.display = 'none';
        }
      }

      async function loadOrders() {
        loadingEl.hidden = false;
        loadingEl.style.display = 'block';
        emptyEl.hidden = true;
        emptyEl.style.display = 'none';
        ordersContainer.hidden = true;
        ordersContainer.style.display = 'none';

        try {
          var res = await fetch('/api/client/orders', { cache: 'no-store' });
          var data = await res.json();

          loadingEl.hidden = true;
          loadingEl.style.display = 'none';

          if (res.ok && data.success && Array.isArray(data.orders)) {
            ordersData = data.orders;
            if (ordersData.length === 0) {
              if (countBadgeEl) countBadgeEl.textContent = '0 pedidos';
              emptyEl.hidden = false;
              emptyEl.style.display = 'block';
            } else {
              if (countBadgeEl) countBadgeEl.textContent = ordersData.length + (ordersData.length === 1 ? ' pedido' : ' pedidos');
              
              // Se nenhuma ordem estiver expandida ainda, expande o primeiro pedido automaticamente
              if (Object.keys(expandedOrderIds).length === 0 && ordersData[0]) {
                expandedOrderIds[ordersData[0].id] = true;
              }

              renderOrders(ordersData);
              ordersContainer.hidden = false;
              ordersContainer.style.display = 'flex';
            }
          } else {
            emptyEl.hidden = false;
            emptyEl.style.display = 'block';
          }
        } catch (err) {
          loadingEl.hidden = true;
          loadingEl.style.display = 'none';
          emptyEl.hidden = false;
          emptyEl.style.display = 'block';
        }
      }

      function renderOrders(orders) {
        ordersContainer.innerHTML = '';

        orders.forEach(function (order) {
          var statusInfo = STATUS_MAP[order.status] || STATUS_MAP.enviado;
          var isExpanded = Boolean(expandedOrderIds[order.id]);

          // Mapeia alterações
          var changesMap = {};
          if (Array.isArray(order.changes)) {
            order.changes.forEach(function (c) {
              if (c.id) changesMap[String(c.id)] = c;
              if (c.title) changesMap[c.title.toLowerCase().trim()] = c;
            });
          }

          var hasChanges = Boolean(
            (order.changes && order.changes.length > 0) ||
            order.status === 'aprovado_com_alteracoes' ||
            order.status === 'alteracoes_aceitas'
          );

          var isPendingApproval = Boolean(
            order.status === 'aprovado_com_alteracoes' ||
            (hasChanges && !order.clientApprovedAt && order.status !== 'alteracoes_aceitas' && order.status !== 'despachado')
          );

          var isChangesApproved = Boolean(
            order.status === 'alteracoes_aceitas' ||
            order.clientApprovedAt
          );

          var isApprovedClean = Boolean(
            (order.status === 'aprovado' || order.status === 'confirmado') &&
            !hasChanges
          );

          var isDispatched = Boolean(
            order.status === 'despachado' ||
            order.dispatchedAt
          );

          // Card principal do Accordion
          var card = document.createElement('article');
          card.className = 'order-accordion-card ' + (isExpanded ? 'is-expanded' : '');
          card.setAttribute('data-order-id', order.id);

          // Gera HTML dos itens
          var itemsHtml = (order.items || []).map(function (it, idx) {
            var change = changesMap[String(it.id)] || (it.title ? changesMap[it.title.toLowerCase().trim()] : null);
            
            // É cancelado?
            var isCancelled = Boolean(
              (change && Number(change.newQty) === 0) ||
              Number(it.quantity) === 0 ||
              it.status === 'cancelado'
            );

            // É quantidade reduzida/alterada?
            var isModified = !isCancelled && Boolean(
              change && (Number(change.newQty) < Number(change.oldQty) || Number(change.newQty) !== Number(change.oldQty))
            );

            var rowClass = 'item-row-normal';
            var tagBadgeHtml = '';
            var qtyDisplay = '';
            var priceDisplay = '';

            var unitPrice = it.priceCents || 18999;
            var currentQty = isCancelled ? 0 : Number(it.quantity || 1);
            var itemTotal = unitPrice * currentQty;

            if (isCancelled) {
              rowClass = 'item-row-cancelled';
              var originalReq = (change && change.oldQty) ? change.oldQty : (it.requestedQuantity || 1);
              tagBadgeHtml = '<span class="item-tag tag-cancelled">🚫 Item Cancelado — Esgotado no estoque</span>';
              qtyDisplay = `
                <div class="item-qty-box">
                  <span class="qty-badge-cancelled">0 un.</span>
                  <span class="qty-sub-cancelled">Solicitado: ${originalReq} un.</span>
                </div>
              `;
              priceDisplay = `
                <div class="item-price-box">
                  <del class="old-price-strike">${formatBRL(unitPrice * originalReq)}</del>
                  <strong class="price-val-cancelled">R$ 0,00</strong>
                </div>
              `;
            } else if (isModified) {
              rowClass = 'item-row-modified';
              tagBadgeHtml = `<span class="item-tag tag-modified">⚠️ Qtd alterada por estoque (solicitado: ${change.oldQty} un.)</span>`;
              qtyDisplay = `
                <div class="item-qty-box">
                  <span class="qty-badge-modified">${currentQty} un.</span>
                  <span class="qty-sub-modified">De ${change.oldQty} un. para ${currentQty} un.</span>
                </div>
              `;
              priceDisplay = `
                <div class="item-price-box">
                  <span class="item-unit-price">${formatBRL(unitPrice)} un.</span>
                  <strong class="price-val-modified">${formatBRL(itemTotal)}</strong>
                </div>
              `;
            } else {
              rowClass = 'item-row-normal';
              qtyDisplay = `
                <div class="item-qty-box">
                  <span class="qty-badge-normal">${currentQty} un.</span>
                </div>
              `;
              priceDisplay = `
                <div class="item-price-box">
                  <span class="item-unit-price">${formatBRL(unitPrice)} un.</span>
                  <strong class="price-val-normal">${formatBRL(itemTotal)}</strong>
                </div>
              `;
            }

            var albumFormat = Number(it.units) === 1 ? 'Álbum Simples' : (Number(it.units) === 2 ? 'Álbum Duplo' : `${it.units || 1} LPs`);

            return `
              <div class="order-disc-row ${rowClass}">
                <div class="disc-left">
                  <img src="${it.cover || '/assets/covers/album-01.webp'}" alt="" class="disc-cover" loading="lazy" />
                  <div class="disc-meta">
                    <div class="disc-title-row">
                      <strong class="disc-title ${isCancelled ? 'strike-title' : ''}">${escapeHtml(it.title || 'Disco de Vinil')}</strong>
                      ${tagBadgeHtml}
                    </div>
                    <span class="disc-sub">${escapeHtml(it.artist || 'Artista')} · ${albumFormat}</span>
                  </div>
                </div>
                <div class="disc-right">
                  ${qtyDisplay}
                  ${priceDisplay}
                </div>
              </div>
            `;
          }).join('');

          // Mensagem de suporte via WhatsApp
          var whatsappMsg = 'Olá, equipe RSTK! Gostaria de falar sobre o pedido #' + order.orderNumber + ' da minha loja (' + (clientData.nomeFantasia || clientData.razaoSocial) + ').';
          var whatsappSupportUrl = 'https://wa.me/553488293565?text=' + encodeURIComponent(whatsappMsg);

          // Constrói banners informativos
          var noticeHtml = '';
          if (isPendingApproval) {
            noticeHtml = `
              <div class="order-notice-box notice-warning">
                <div class="notice-top">
                  <div class="notice-icon-circle">⚠️</div>
                  <div class="notice-text">
                    <strong>Atenção: Houve alteração no seu pedido devido ao estoque disponível</strong>
                    <p>Durante a separação, alguns discos tiveram a quantidade reajustada ou foram cancelados por esgotamento. Veja o destaque dos itens abaixo (em amarelo ou vermelho). O valor total atualizado do pedido é <strong>${formatBRL(order.totalCents)}</strong>.</p>
                    ${order.adminNotes ? `<p class="admin-notice-quote"><strong>Mensagem da RSTK:</strong> "${escapeHtml(order.adminNotes)}"</p>` : ''}
                  </div>
                </div>
                <div class="notice-bottom-action">
                  <button type="button" class="btn-approve-changes" data-order-id="${order.id}">
                    <span class="btn-icon">✓</span>
                    <span>Aprovar Alterações do Pedido</span>
                  </button>
                </div>
              </div>
            `;
          } else if (isChangesApproved) {
            noticeHtml = `
              <div class="order-notice-box notice-success">
                <div class="notice-top">
                  <div class="notice-icon-circle">✓</div>
                  <div class="notice-text">
                    <strong>Alterações aprovadas pela sua loja!</strong>
                    <p>Você aprovou a composição revisada deste pedido${order.clientApprovedAt ? ' em ' + formatDateTimeBR(order.clientApprovedAt) : ''}. A equipe RSTK foi notificada e já pode despachar sua encomenda.</p>
                  </div>
                </div>
              </div>
            `;
          } else if (isDispatched) {
            noticeHtml = `
              <div class="order-notice-box notice-dispatched">
                <div class="notice-top">
                  <div class="notice-icon-circle">🚚</div>
                  <div class="notice-text">
                    <strong>Pedido Despachado com Sucesso!</strong>
                    <p>Seus vinis já foram despachados pela equipe RSTK${order.dispatchedAt ? ' em ' + formatDateTimeBR(order.dispatchedAt) : ''}. Em breve você receberá as informações de rastreio e entrega.</p>
                  </div>
                </div>
              </div>
            `;
          } else if (isApprovedClean) {
            noticeHtml = `
              <div class="order-notice-box notice-success">
                <div class="notice-top">
                  <div class="notice-icon-circle">✓</div>
                  <div class="notice-text">
                    <strong>Pedido 100% Aprovado pela RSTK!</strong>
                    <p>Todos os itens e quantidades foram confirmados em estoque. Seu pedido está em processo de separação e expedição.</p>
                  </div>
                </div>
              </div>
            `;
          } else {
            noticeHtml = `
              <div class="order-notice-box notice-info">
                <div class="notice-top">
                  <div class="notice-icon-circle">📋</div>
                  <div class="notice-text">
                    <strong>Pedido Enviado — Em Análise pela RSTK</strong>
                    <p>Seu pedido foi registrado no sistema. Nossa equipe está conferindo os títulos e estoque para faturamento. Qualquer alteração ou atualização de status será exibida aqui.</p>
                  </div>
                </div>
              </div>
            `;
          }

          card.innerHTML = `
            <!-- Linha Resumo do Accordion (Clicável) -->
            <div class="order-summary-row" role="button" tabindex="0" aria-expanded="${isExpanded}">
              <div class="summary-col col-order-id">
                <div class="order-hash-id">
                  <span class="hash-symbol">#</span>
                  <span class="hash-number">${order.orderNumber}</span>
                </div>
                <span class="order-created-date">${formatDateTimeBR(order.createdAt)}</span>
              </div>

              <div class="summary-col col-order-qty">
                <span class="col-caption">Discos no Pedido</span>
                <span class="col-value-qty"><strong>${order.itemCount}</strong> disco(s)</span>
              </div>

              <div class="summary-col col-order-total">
                <span class="col-caption">Valor Total</span>
                <span class="col-value-total">${formatBRL(order.totalCents)}</span>
              </div>

              <div class="summary-col col-order-status">
                <span class="badge-status-pill ${statusInfo.badgeClass}">
                  <span class="badge-status-dot"></span>
                  <span class="badge-status-text">${statusInfo.label}</span>
                </span>
              </div>

              <div class="summary-col col-order-toggle">
                <span class="toggle-link-text">${isExpanded ? 'Ocultar detalhes' : 'Ver detalhes'}</span>
                <span class="toggle-chevron ${isExpanded ? 'rotated' : ''}">▼</span>
              </div>
            </div>

            <!-- Gaveta de Detalhes do Pedido -->
            <div class="order-details-drawer" ${isExpanded ? '' : 'hidden'}>
              ${noticeHtml}

              <div class="discs-section">
                <div class="discs-section-header">
                  <h3>Itens do Pedido (${order.itemCount} unidades)</h3>
                  <span class="discs-hint">Revise cada título e suas respectivas quantidades</span>
                </div>

                <div class="discs-list">
                  ${itemsHtml}
                </div>
              </div>

              ${order.notes ? `
                <div class="order-notes-bar">
                  <span class="notes-label">Observações da Loja:</span>
                  <p class="notes-content">${escapeHtml(order.notes)}</p>
                </div>
              ` : ''}

              <!-- Rodapé da Gaveta -->
              <div class="order-drawer-footer">
                <div class="footer-totals">
                  <div class="footer-total-line">
                    <span class="label">Total Final do Pedido:</span>
                    <strong class="value">${formatBRL(order.totalCents)}</strong>
                  </div>
                </div>

                <div class="footer-actions">
                  <a href="${whatsappSupportUrl}" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-order">
                    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.18-.077.355.101.174.45 1.742 1.488 2.063.267.082.477.068.654-.044.224-.143.636-.738.809-.991.173-.253.347-.211.583-.125.237.086 1.503.708 1.763.838.26.13.433.195.498.304.065.109.065.636-.079 1.041z"/>
                    </svg>
                    <span>Falar no WhatsApp sobre este Pedido</span>
                  </a>

                  ${isPendingApproval ? `
                    <button type="button" class="btn-approve-changes" data-order-id="${order.id}">
                      <span class="btn-icon">✓</span>
                      <span>Aprovar Alterações do Pedido</span>
                    </button>
                  ` : ''}
                </div>
              </div>
            </div>
          `;

          // Event Listener para alternar Accordion ao clicar no resumo
          var summaryRow = card.querySelector('.order-summary-row');
          summaryRow.addEventListener('click', function (e) {
            // Se clicou em um link ou botão dentro do cabeçalho, não alterna
            if (e.target.closest('button, a')) return;
            toggleAccordion(order.id);
          });

          // Acessibilidade por teclado (Enter ou Espaço)
          summaryRow.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              toggleAccordion(order.id);
            }
          });

          // Event Listener para o botão de aprovar alterações
          var approveBtns = card.querySelectorAll('.btn-approve-changes');
          approveBtns.forEach(function (btn) {
            btn.addEventListener('click', function (e) {
              e.stopPropagation();
              handleApproveChanges(order.id, btn);
            });
          });

          ordersContainer.appendChild(card);
        });
      }

      function toggleAccordion(orderId) {
        if (expandedOrderIds[orderId]) {
          delete expandedOrderIds[orderId];
        } else {
          expandedOrderIds[orderId] = true;
        }
        renderOrders(ordersData);
      }

      async function handleApproveChanges(orderId, btnEl) {
        if (!confirm('Deseja aprovar e confirmar as alterações deste pedido? A equipe RSTK será notificada imediatamente para despachar seus discos.')) {
          return;
        }

        if (btnEl) {
          btnEl.disabled = true;
          btnEl.innerHTML = '<span class="spinner-small"></span> Aprovando...';
        }

        try {
          var res = await fetch('/api/client/approve-changes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: orderId })
          });
          var data = await res.json();

          if (res.ok && data.success) {
            alert(data.message || 'Alterações aprovadas com sucesso! A RSTK foi notificada para providenciar o despacho.');
            // Mantém este pedido expandido
            expandedOrderIds[orderId] = true;
            loadOrders();
          } else {
            alert(data.error || 'Erro ao aprovar alterações.');
            if (btnEl) {
              btnEl.disabled = false;
              btnEl.innerHTML = '<span class="btn-icon">✓</span><span>Aprovar Alterações do Pedido</span>';
            }
          }
        } catch (err) {
          alert('Erro de conexão ao aprovar alterações. Tente novamente.');
          if (btnEl) {
            btnEl.disabled = false;
            btnEl.innerHTML = '<span class="btn-icon">✓</span><span>Aprovar Alterações do Pedido</span>';
          }
        }
      }

      function checkPendingCart() {
        var banner = document.getElementById('pending-cart-banner');
        var titleEl = document.getElementById('pending-cart-title');
        if (!banner) return;
        try {
          var raw = localStorage.getItem('rstk-selection');
          var items = raw ? JSON.parse(raw) : [];
          if (Array.isArray(items) && items.length > 0) {
            var count = items.length;
            if (titleEl) {
              titleEl.textContent = 'Você possui ' + count + ' vinil(is) no carrinho prontos para envio!';
            }
            banner.hidden = false;
            banner.style.display = 'flex';
            return;
          }
        } catch (e) {}
        banner.hidden = true;
        banner.style.display = 'none';
      }

      var btnResend = document.getElementById('btn-resend-verification');
      if (btnResend) {
        btnResend.addEventListener('click', async function () {
          btnResend.disabled = true;
          btnResend.textContent = 'Enviando...';
          try {
            var res = await fetch('/api/client/resend-verification', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: clientData ? clientData.email : '' })
            });
            var data = await res.json();
            if (res.ok && data.success) {
              alert(data.message || 'E-mail de confirmação reenviado com sucesso! Verifique sua caixa de entrada.');
              btnResend.textContent = 'E-mail Reenviado ✓';
            } else {
              alert(data.error || 'Erro ao reenviar e-mail.');
              btnResend.disabled = false;
              btnResend.textContent = 'Reenviar E-mail';
            }
          } catch (e) {
            alert('Erro de conexão ao reenviar e-mail.');
            btnResend.disabled = false;
            btnResend.textContent = 'Reenviar E-mail';
          }
        });
      }

      btnLogout.addEventListener('click', async function () {
        if (!confirm('Deseja realmente sair da sua conta?')) return;
        try {
          await fetch('/api/client/logout', { method: 'POST' });
        } catch (e) {}
        window.location.replace('/');
      });

      btnRefresh.addEventListener('click', function () {
        btnRefresh.classList.add('rotating');
        setTimeout(function () {
          btnRefresh.classList.remove('rotating');
        }, 600);
        loadOrders();
        checkPendingCart();
      });

      checkAuth();
      checkPendingCart();
    })();
  </script>

