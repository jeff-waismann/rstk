---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogData from '../../data/catalog.json';
import siteSettingsData from '../../data/siteSettings.json';
import type { SiteSettings, VinylAlbum } from '../../utils/format';

const allProducts = catalogData as VinylAlbum[];
const siteSettings = {
  ...(siteSettingsData as SiteSettings),
  seoTitle: 'Meus Pedidos & Área do Cliente — RSTK Atacado',
  seoDescription: 'Acompanhe seus pedidos de vinis no atacado, status de aprovação e histórico de compras da sua loja.'
};
---

<BaseLayout
  settings={siteSettings}
  products={allProducts}
  heroCovers={allProducts.slice(0, 3)}
  canonicalPath="/cliente/pedidos"
  noindex={true}
>
  <header class="top">
    <div class="wrap">
      <a class="brand" href="/" aria-label="RSTK Atacado — início">
        <img
          id="brand-logo"
          src={siteSettings.logoUrl || '/assets/images/logo-rstk.webp'}
          alt={siteSettings.brandAlt || 'RSTK ATACADO'}
          width="205"
          height="88"
          fetchpriority="high"
        />
      </a>
      <div class="top-right">
        <a href="/" class="header-back-catalog">
          ← Voltar ao Catálogo
        </a>
        <div class="theme" role="group" aria-label="Tema de aparência">
          <button id="light" type="button" aria-pressed="true">☀ Claro</button>
          <button id="dark" type="button" aria-pressed="false">☾ Escuro</button>
        </div>
      </div>
    </div>
  </header>

  <main class="portal-page">
    <div class="portal-container">
      {/* Top Header do Portal do Cliente */}
      <div class="portal-header">
        <div class="portal-welcome">
          <span class="badge-b2b">Área da Loja / Revenda</span>
          <h1 id="client-company-name">Carregando seus dados...</h1>
          <p id="client-info-sub" class="client-sub">Consultando seus dados cadastrais...</p>
        </div>
        <div class="portal-header-actions">
          <a href="/" class="btn-new-order">
            <span>+ Novo Pedido no Catálogo</span>
          </a>
          <button type="button" id="btn-logout" class="btn-logout-portal">
            Sair da Conta
          </button>
        </div>
      </div>

      {/* Banner de Aviso: E-mail não confirmado */}
      <div id="unverified-banner" class="unverified-banner" hidden>
        <div class="unverified-left">
          <div class="unverified-icon">✉</div>
          <div class="unverified-content">
            <strong>Confirmação de e-mail pendente</strong>
            <p>Enviamos um link de confirmação para sua caixa de entrada. Você já pode enviar seus pedidos normalmente e confirmar o e-mail quando quiser.</p>
          </div>
        </div>
        <button type="button" id="btn-resend-verification" class="btn-resend-email">
          Reenviar E-mail
        </button>
      </div>

      {/* Banner de Pedido em Andamento no Carrinho */}
      <div id="pending-cart-banner" class="pending-cart-card" hidden>
        <div class="pending-cart-left">
          <span class="pending-cart-icon">🛒</span>
          <div>
            <strong id="pending-cart-title">Você possui itens no carrinho prontos para envio!</strong>
            <p>Seus vinis continuam salvos e você pode enviar seu pedido diretamente pela sua conta.</p>
          </div>
        </div>
        <a href="/?openCart=1" class="btn-finalize-pending">
          Revisar e Enviar Pedido →
        </a>
      </div>

      <div id="portal-alert" class="alert-box" hidden></div>

      {/* Seção Principal: Tabela de Pedidos Identica ao Painel Admin */}
      <div class="portal-content">
        <div id="orders-loading" class="orders-loading">
          <div class="spinner"></div>
          <p>Carregando histórico de pedidos da sua loja...</p>
        </div>

        <div id="orders-empty" class="orders-empty" hidden>
          <div class="empty-icon">📦</div>
          <h3>Nenhum pedido encontrado</h3>
          <p>Sua loja ainda não realizou pedidos vinculados a esta conta. Escolha seus vinis no catálogo e envie seu pedido para acompanhar tudo por aqui!</p>
          <a href="/" class="btn-primary-portal">Explorar Catálogo de Vinis →</a>
        </div>

        {/* Card da Tabela de Pedidos Estilo Admin */}
        <div id="orders-table-card" class="orders-card-admin" hidden>
          <div class="orders-card-header">
            <div>
              <h3 class="orders-card-title">Histórico de Pedidos & Revendas</h3>
              <p class="orders-card-sub">Pedidos associados a sua conta de revenda (B2B) ou enviados via WhatsApp.</p>
            </div>
            <div class="orders-card-right">
              <span id="orders-count-badge" class="orders-count-text">0 pedido(s)</span>
              <button type="button" id="btn-refresh-orders" class="btn-refresh-admin" title="Atualizar pedidos">
                <span class="refresh-icon">↻</span>
              </button>
            </div>
          </div>

          <div class="orders-table-scroll">
            <table class="admin-orders-table">
              <thead>
                <tr>
                  <th class="th-code">PEDIDO / DATA</th>
                  <th class="th-items">ITENS</th>
                  <th class="th-total">VALOR TOTAL</th>
                  <th class="th-status">STATUS</th>
                  <th class="th-actions text-right">AÇÕES</th>
                </tr>
              </thead>
              <tbody id="orders-tbody">
                {/* Linhas inseridas dinamicamente via JS */}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>

  {/* ========================================================
      MODAL / POP-UP DE GESTÃO DO PEDIDO (IDENTICO AO ADMIN)
      ======================================================== */}
  <div id="order-modal" class="modal-backdrop" hidden>
    <div class="modal-admin-window" role="dialog" aria-modal="true" aria-labelledby="modal-order-number">
      {/* Header do Pop-up */}
      <div class="modal-admin-header">
        <div>
          <span class="modal-eyebrow">Gestão do Pedido</span>
          <h3 id="modal-order-number" class="modal-order-code">#PED-XXXXXX</h3>
        </div>
        <button type="button" id="modal-close-btn" class="modal-close-icon" aria-label="Fechar modal">
          ✕
        </button>
      </div>

      {/* Conteúdo com Scroll */}
      <div class="modal-admin-body">
        {/* Banner de Aviso de Alterações (se houver) */}
        <div id="modal-notice-container"></div>

        {/* Card de Status Atual do Pedido */}
        <div class="modal-status-bar">
          <div>
            <span class="status-bar-caption">Status Atual:</span>
            <div id="modal-status-pill-wrap"></div>
          </div>
          <div class="status-bar-date-col">
            <span class="status-bar-caption">Data do Pedido:</span>
            <span id="modal-order-date" class="status-bar-date-val">—</span>
          </div>
        </div>

        {/* Ajuste de Itens e Quantidades (Listagem idêntica ao admin) */}
        <div class="modal-items-container">
          <div class="modal-items-top-bar">
            <h4 id="modal-items-title" class="modal-items-heading">
              Itens do Pedido (0)
            </h4>
            <span id="modal-items-total-preview" class="modal-items-total-tag">
              Total: R$ 0,00
            </span>
          </div>

          <div id="modal-discs-list" class="modal-items-divide-list">
            {/* Linhas de itens renderizadas dinamicamente */}
          </div>
        </div>

        {/* Observações do Pedido */}
        <div id="modal-notes-box" class="modal-admin-notes" hidden>
          <span class="notes-caption">Observações do Pedido:</span>
          <p id="modal-notes-text" class="notes-val"></p>
        </div>
      </div>

      {/* Rodapé do Pop-up */}
      <div class="modal-admin-footer">
        <div class="modal-footer-total-box">
          <span class="caption">Valor Total:</span>
          <strong id="modal-total-cents" class="total-val">R$ 0,00</strong>
        </div>

        <div class="modal-footer-btn-group">
          <a id="modal-whatsapp-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn-admin-whatsapp">
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.18-.077.355.101.174.45 1.742 1.488 2.063.267.082.477.068.654-.044.224-.143.636-.738.809-.991.173-.253.347-.211.583-.125.237.086 1.503.708 1.763.838.26.13.433.195.498.304.065.109.065.636-.079 1.041z"/>
            </svg>
            <span>WhatsApp</span>
          </a>

          <button type="button" id="modal-approve-btn" class="btn-admin-approve" hidden>
            <span>✓ Confirmar Alterações</span>
          </button>

          <button type="button" id="modal-secondary-close" class="btn-admin-close">
            Fechar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var clientData = null;
      var ordersData = [];
      var selectedOrder = null;

      var alertBox = document.getElementById('portal-alert');
      var tableCardEl = document.getElementById('orders-table-card');
      var tbodyEl = document.getElementById('orders-tbody');
      var loadingEl = document.getElementById('orders-loading');
      var emptyEl = document.getElementById('orders-empty');
      var countBadgeEl = document.getElementById('orders-count-badge');
      var companyNameEl = document.getElementById('client-company-name');
      var infoSubEl = document.getElementById('client-info-sub');
      var unverifiedBanner = document.getElementById('unverified-banner');
      var btnLogout = document.getElementById('btn-logout');
      var btnRefresh = document.getElementById('btn-refresh-orders');

      // Elementos do Modal
      var modalEl = document.getElementById('order-modal');
      var modalCloseBtn = document.getElementById('modal-close-btn');
      var modalSecondaryClose = document.getElementById('modal-secondary-close');
      var modalOrderNumber = document.getElementById('modal-order-number');
      var modalOrderDate = document.getElementById('modal-order-date');
      var modalNoticeContainer = document.getElementById('modal-notice-container');
      var modalStatusPillWrap = document.getElementById('modal-status-pill-wrap');
      var modalItemsTitle = document.getElementById('modal-items-title');
      var modalItemsTotalPreview = document.getElementById('modal-items-total-preview');
      var modalDiscsList = document.getElementById('modal-discs-list');
      var modalNotesBox = document.getElementById('modal-notes-box');
      var modalNotesText = document.getElementById('modal-notes-text');
      var modalTotalCents = document.getElementById('modal-total-cents');
      var modalWhatsappBtn = document.getElementById('modal-whatsapp-btn');
      var modalApproveBtn = document.getElementById('modal-approve-btn');

      function formatBRL(cents) {
        return ((cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      }

      function formatDateTimeBR(dateStr) {
        if (!dateStr) return '—';
        try {
          var clean = dateStr.replace(' ', 'T');
          if (!clean.includes('Z') && !clean.includes('+') && !clean.includes('-')) {
            clean += 'Z';
          }
          var d = new Date(clean);
          return d.toLocaleString('pt-BR', {
            timeZone: 'America/Sao_Paulo',
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
        } catch (e) {
          return dateStr;
        }
      }

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // Mapeamento de Status IDÊNTICO ao Admin (cores pastéis, bordas suaves e bolinha)
      var STATUS_MAP = {
        despachado: {
          label: 'Despachado',
          badgeClass: 'badge-purple',
          dotClass: 'dot-purple'
        },
        concluido: {
          label: 'Concluído / Despachado',
          badgeClass: 'badge-purple',
          dotClass: 'dot-purple'
        },
        enviado: {
          label: 'Enviado / Em Análise',
          badgeClass: 'badge-sky',
          dotClass: 'dot-sky'
        },
        whatsapp_aberto: {
          label: 'Enviado / Em Análise',
          badgeClass: 'badge-sky',
          dotClass: 'dot-sky'
        },
        aprovado: {
          label: 'Aprovado',
          badgeClass: 'badge-emerald',
          dotClass: 'dot-emerald'
        },
        confirmado: {
          label: 'Aprovado',
          badgeClass: 'badge-emerald',
          dotClass: 'dot-emerald'
        },
        aprovado_com_alteracoes: {
          label: 'Aprovado c/ Alterações',
          badgeClass: 'badge-amber',
          dotClass: 'dot-amber'
        },
        alteracoes_aceitas: {
          label: 'Alterações Aprovadas',
          badgeClass: 'badge-teal',
          dotClass: 'dot-teal'
        },
        cancelado: {
          label: 'Cancelado',
          badgeClass: 'badge-red',
          dotClass: 'dot-red'
        }
      };

      async function checkAuth() {
        try {
          var res = await fetch('/api/client/me', { cache: 'no-store' });
          var data = await res.json();
          if (!res.ok || !data.loggedIn) {
            window.location.replace('/cliente/login');
            return;
          }
          clientData = data.client;
          renderClientHeader();
          loadOrders();
        } catch (err) {
          window.location.replace('/cliente/login');
        }
      }

      function renderClientHeader() {
        if (!clientData) return;
        var displayName = clientData.nomeFantasia || clientData.razaoSocial;
        companyNameEl.textContent = displayName;
        var isVerified = Boolean(clientData.emailVerified === true || clientData.emailVerified === 1 || clientData.emailVerified === '1');
        infoSubEl.textContent = 'CNPJ: ' + (clientData.cnpj || '—') + ' · Responsável: ' + (clientData.responsavelNome || '—') + ' (' + clientData.email + ')';

        if (!isVerified) {
          unverifiedBanner.hidden = false;
          unverifiedBanner.style.display = 'flex';
        } else {
          unverifiedBanner.hidden = true;
          unverifiedBanner.style.display = 'none';
        }
      }

      async function loadOrders() {
        loadingEl.hidden = false;
        loadingEl.style.display = 'block';
        emptyEl.hidden = true;
        emptyEl.style.display = 'none';
        tableCardEl.hidden = true;
        tableCardEl.style.display = 'none';

        try {
          var res = await fetch('/api/client/orders', { cache: 'no-store' });
          var data = await res.json();

          loadingEl.hidden = true;
          loadingEl.style.display = 'none';

          if (res.ok && data.success && Array.isArray(data.orders)) {
            ordersData = data.orders;
            if (ordersData.length === 0) {
              if (countBadgeEl) countBadgeEl.textContent = '0 pedido(s)';
              emptyEl.hidden = false;
              emptyEl.style.display = 'block';
            } else {
              if (countBadgeEl) countBadgeEl.textContent = ordersData.length + ' pedido(s)';
              renderOrdersTable(ordersData);
              tableCardEl.hidden = false;
              tableCardEl.style.display = 'block';

              // Se o modal estiver aberto, atualiza o pedido selecionado
              if (selectedOrder) {
                var refreshed = ordersData.find(function (o) { return o.id === selectedOrder.id; });
                if (refreshed) openOrderModal(refreshed);
              }
            }
          } else {
            emptyEl.hidden = false;
            emptyEl.style.display = 'block';
          }
        } catch (err) {
          loadingEl.hidden = true;
          loadingEl.style.display = 'none';
          emptyEl.hidden = false;
          emptyEl.style.display = 'block';
        }
      }

      function renderOrdersTable(orders) {
        tbodyEl.innerHTML = '';

        orders.forEach(function (order) {
          var statusInfo = STATUS_MAP[order.status] || STATUS_MAP.enviado;
          var items = order.items || [];
          var firstItem = items[0] || {};
          var remainingCount = items.length > 1 ? items.length - 1 : 0;

          // Capas sobrepostas (estilo admin -space-x-2)
          var coversHtml = items.slice(0, 3).map(function (it) {
            return `<img src="${it.cover || '/assets/covers/album-01.webp'}" alt="" class="item-stack-thumb" loading="lazy" />`;
          }).join('');

          var titleSummary = (firstItem.title || 'Disco de Vinil') + (remainingCount > 0 ? ` (+${remainingCount})` : '');

          var whatsappSupportUrl = 'https://wa.me/553488293565?text=' + encodeURIComponent(
            'Olá, RSTK! Gostaria de falar sobre o pedido #' + order.orderNumber + ' da minha loja (' + (clientData.nomeFantasia || clientData.razaoSocial) + ').'
          );

          var tr = document.createElement('tr');
          tr.className = 'admin-row-item';

          tr.innerHTML = `
            <td class="td-order-code">
              <a href="javascript:void(0)" class="order-code-link" data-order-id="${order.id}">
                #${order.orderNumber}
              </a>
              <span class="order-date-sub">${formatDateTimeBR(order.createdAt)}</span>
            </td>

            <td class="td-items-col">
              <div class="items-cell-flex">
                <div class="covers-overlap-stack">
                  ${coversHtml}
                </div>
                <div class="items-meta-text">
                  <p class="items-title-first">${escapeHtml(titleSummary)}</p>
                  <span class="items-total-qty">${order.itemCount} un.</span>
                </div>
              </div>
            </td>

            <td class="td-total-col">
              <span class="total-price-admin">${formatBRL(order.totalCents)}</span>
            </td>

            <td class="td-status-col">
              <span class="admin-status-pill ${statusInfo.badgeClass}">
                <span class="admin-status-dot ${statusInfo.dotClass}"></span>
                <span class="admin-status-text">${statusInfo.label}</span>
              </span>
            </td>

            <td class="td-actions-col text-right">
              <div class="row-actions-group">
                <a href="${whatsappSupportUrl}" target="_blank" rel="noopener noreferrer" class="btn-row-whatsapp" title="Falar no WhatsApp sobre este pedido">
                  <svg viewBox="0 0 24 24" class="w-3-5 h-3-5" fill="currentColor">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.347.491 1.2.534 1.288.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.18-.077.355.101.174.45 1.742 1.488 2.063.267.082.477.068.654-.044.224-.143.636-.738.809-.991.173-.253.347-.211.583-.125.237.086 1.503.708 1.763.838.26.13.433.195.498.304.065.109.065.636-.079 1.041z"/>
                  </svg>
                  <span>WhatsApp</span>
                </a>

                <button type="button" class="btn-row-details-blue" data-order-id="${order.id}">
                  <span>📝 Detalhes</span>
                </button>
              </div>
            </td>
          `;

          // Event Listeners para abrir o modal
          var codeLink = tr.querySelector('.order-code-link');
          var detailsBtn = tr.querySelector('.btn-row-details-blue');

          codeLink.addEventListener('click', function (e) {
            e.stopPropagation();
            openOrderModal(order);
          });

          detailsBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            openOrderModal(order);
          });

          tr.addEventListener('click', function (e) {
            if (e.target.closest('a, button')) return;
            openOrderModal(order);
          });

          tbodyEl.appendChild(tr);
        });
      }

      // ========================================================
      // GESTÃO DO POP-UP (MODAL DE DETALHES - IGUAL AO ADMIN)
      // ========================================================
      function openOrderModal(order) {
        selectedOrder = order;
        var statusInfo = STATUS_MAP[order.status] || STATUS_MAP.enviado;

        modalOrderNumber.textContent = '#' + order.orderNumber;
        modalOrderDate.textContent = formatDateTimeBR(order.createdAt);
        modalItemsTitle.textContent = `Itens do Pedido (${(order.items || []).length})`;
        modalItemsTotalPreview.textContent = `Total: ${formatBRL(order.totalCents)}`;
        modalTotalCents.textContent = formatBRL(order.totalCents);

        // Badge de Status Atual no Modal
        modalStatusPillWrap.innerHTML = `
          <span class="admin-status-pill ${statusInfo.badgeClass}">
            <span class="admin-status-dot ${statusInfo.dotClass}"></span>
            <span class="admin-status-text">${statusInfo.label}</span>
          </span>
        `;

        // Mapeia alterações efetuadas pela equipe RSTK
        var changesMap = {};
        if (Array.isArray(order.changes)) {
          order.changes.forEach(function (c) {
            if (c.id) changesMap[String(c.id)] = c;
            if (c.title) changesMap[c.title.toLowerCase().trim()] = c;
          });
        }

        var hasChanges = Boolean(
          (order.changes && order.changes.length > 0) ||
          order.status === 'aprovado_com_alteracoes' ||
          order.status === 'alteracoes_aceitas'
        );

        var isPendingApproval = Boolean(
          order.status === 'aprovado_com_alteracoes' ||
          (hasChanges && !order.clientApprovedAt && order.status !== 'alteracoes_aceitas' && order.status !== 'despachado')
        );

        var isChangesApproved = Boolean(
          order.status === 'alteracoes_aceitas' ||
          order.clientApprovedAt
        );

        var isDispatched = Boolean(
          order.status === 'despachado' ||
          order.dispatchedAt
        );

        // Banner de Alerta de Alterações no Modal
        modalNoticeContainer.innerHTML = '';
        if (isPendingApproval) {
          modalNoticeContainer.innerHTML = `
            <div class="admin-notice-box notice-box-amber">
              <div class="notice-flex-row">
                <span class="notice-symbol">⚠️</span>
                <div>
                  <strong>Atenção: A equipe RSTK realizou alterações neste pedido</strong>
                  <p>Houve ajuste na composição por disponibilidade de estoque. Confira os itens em destaque abaixo. O valor total atualizado é <strong>${formatBRL(order.totalCents)}</strong>.</p>
                  ${order.adminNotes ? `<p class="admin-quote-note"><em>Mensagem da RSTK: "${escapeHtml(order.adminNotes)}"</em></p>` : ''}
                </div>
              </div>
            </div>
          `;
          modalApproveBtn.hidden = false;
          modalApproveBtn.style.display = 'inline-flex';
        } else if (isChangesApproved) {
          modalNoticeContainer.innerHTML = `
            <div class="admin-notice-box notice-box-teal">
              <div class="notice-flex-row">
                <span class="notice-symbol">✓</span>
                <div>
                  <strong>Alterações aprovadas pela sua loja!</strong>
                  <p>Você confirmou a composição atualizada deste pedido${order.clientApprovedAt ? ' em ' + formatDateTimeBR(order.clientApprovedAt) : ''}. A equipe RSTK foi notificada para despachar.</p>
                </div>
              </div>
            </div>
          `;
          modalApproveBtn.hidden = true;
          modalApproveBtn.style.display = 'none';
        } else if (isDispatched) {
          modalNoticeContainer.innerHTML = `
            <div class="admin-notice-box notice-box-purple">
              <div class="notice-flex-row">
                <span class="notice-symbol">🚚</span>
                <div>
                  <strong>Pedido Despachado com Sucesso!</strong>
                  <p>Seus vinis já foram despachados pela equipe RSTK${order.dispatchedAt ? ' em ' + formatDateTimeBR(order.dispatchedAt) : ''}.</p>
                </div>
              </div>
            </div>
          `;
          modalApproveBtn.hidden = true;
          modalApproveBtn.style.display = 'none';
        }

        // Renderiza itens dentro do Pop-up (Layout Idêntico ao Admin)
        modalDiscsList.innerHTML = '';
        (order.items || []).forEach(function (it) {
          var change = changesMap[String(it.id)] || (it.title ? changesMap[it.title.toLowerCase().trim()] : null);

          var isCancelled = Boolean(
            (change && Number(change.newQty) === 0) ||
            Number(it.quantity) === 0 ||
            it.status === 'cancelado'
          );

          var isModified = !isCancelled && Boolean(
            change && (Number(change.newQty) < Number(change.oldQty) || Number(change.newQty) !== Number(change.oldQty))
          );

          var unitPrice = it.priceCents || 18999;
          var currentQty = isCancelled ? 0 : Number(it.quantity || 1);
          var itemTotal = unitPrice * currentQty;
          var albumFormat = Number(it.units) === 1 ? 'Álbum Simples' : (Number(it.units) === 2 ? 'Álbum Duplo' : `${it.units || 1} LPs`);

          var rowDiv = document.createElement('div');

          if (isCancelled) {
            rowDiv.className = 'admin-item-row row-cancelled';
            var originalReq = (change && change.oldQty) ? change.oldQty : (it.requestedQuantity || 1);
            rowDiv.innerHTML = `
              <div class="item-left-block">
                <img src="${it.cover || '/assets/covers/album-01.webp'}" alt="" class="admin-item-thumb" loading="lazy" />
                <div class="item-meta-block">
                  <p class="item-title-text line-through-text"><s>${escapeHtml(it.title || 'Disco de Vinil')}</s></p>
                  <p class="item-sub-text">${escapeHtml(it.artist || 'Artista')} · ${albumFormat} · ${formatBRL(unitPrice)} un.</p>
                  <span class="tag-status-pill tag-red">🚫 Cancelado — Esgotado no estoque</span>
                </div>
              </div>
              <div class="item-right-block">
                <div class="item-qty-box">
                  <span class="qty-badge-admin qty-zero">0 un.</span>
                  <span class="qty-sub-alert">Solicitado: ${originalReq} un.</span>
                </div>
                <div class="item-price-box">
                  <del class="old-price-strike">${formatBRL(unitPrice * originalReq)}</del>
                  <strong class="item-price-val text-red">R$ 0,00</strong>
                </div>
              </div>
            `;
          } else if (isModified) {
            rowDiv.className = 'admin-item-row row-modified';
            rowDiv.innerHTML = `
              <div class="item-left-block">
                <img src="${it.cover || '/assets/covers/album-01.webp'}" alt="" class="admin-item-thumb" loading="lazy" />
                <div class="item-meta-block">
                  <p class="item-title-text">${escapeHtml(it.title || 'Disco de Vinil')}</p>
                  <p class="item-sub-text">${escapeHtml(it.artist || 'Artista')} · ${albumFormat} · ${formatBRL(unitPrice)} un.</p>
                  <span class="tag-status-pill tag-amber">⚠️ Qtd alterada de ${change.oldQty} para ${it.quantity} un.</span>
                </div>
              </div>
              <div class="item-right-block">
                <div class="item-qty-box">
                  <span class="qty-badge-admin qty-adjusted">${it.quantity} un.</span>
                  <span class="qty-sub-alert">Solicitado: ${change.oldQty} un.</span>
                </div>
                <div class="item-price-box">
                  <span class="item-price-unit">${formatBRL(unitPrice)} un.</span>
                  <strong class="item-price-val text-amber">${formatBRL(itemTotal)}</strong>
                </div>
              </div>
            `;
          } else {
            rowDiv.className = 'admin-item-row row-normal';
            rowDiv.innerHTML = `
              <div class="item-left-block">
                <img src="${it.cover || '/assets/covers/album-01.webp'}" alt="" class="admin-item-thumb" loading="lazy" />
                <div class="item-meta-block">
                  <p class="item-title-text">${escapeHtml(it.title || 'Disco de Vinil')}</p>
                  <p class="item-sub-text">${escapeHtml(it.artist || 'Artista')} · ${albumFormat} · ${formatBRL(unitPrice)} un.</p>
                </div>
              </div>
              <div class="item-right-block">
                <span class="qty-badge-admin">${it.quantity} un.</span>
                <strong class="item-price-val text-brand">${formatBRL(itemTotal)}</strong>
              </div>
            `;
          }

          modalDiscsList.appendChild(rowDiv);
        });

        // Observações do Pedido
        if (order.notes && order.notes.trim()) {
          modalNotesText.textContent = order.notes;
          modalNotesBox.hidden = false;
          modalNotesBox.style.display = 'block';
        } else {
          modalNotesBox.hidden = true;
          modalNotesBox.style.display = 'none';
        }

        // WhatsApp Link no Modal
        var whatsappMsg = 'Olá, equipe RSTK! Gostaria de falar sobre o pedido #' + order.orderNumber + ' da minha loja (' + (clientData.nomeFantasia || clientData.razaoSocial) + ').';
        modalWhatsappBtn.href = 'https://wa.me/553488293565?text=' + encodeURIComponent(whatsappMsg);

        // Exibe o modal
        modalEl.hidden = false;
        modalEl.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modalEl.hidden = true;
        modalEl.style.display = 'none';
        document.body.style.overflow = '';
        selectedOrder = null;
      }

      modalCloseBtn.addEventListener('click', closeModal);
      modalSecondaryClose.addEventListener('click', closeModal);

      modalEl.addEventListener('click', function (e) {
        if (e.target === modalEl) {
          closeModal();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modalEl.hidden) {
          closeModal();
        }
      });

      // Ação de confirmar/aprovar alterações do pedido no modal
      modalApproveBtn.addEventListener('click', async function () {
        if (!selectedOrder) return;
        if (!confirm('Deseja confirmar e aprovar as alterações deste pedido? A equipe RSTK será notificada imediatamente para despachar seus discos.')) {
          return;
        }

        modalApproveBtn.disabled = true;
        modalApproveBtn.innerHTML = '<span class="spinner-small"></span> Confirmando...';

        try {
          var res = await fetch('/api/client/approve-changes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: selectedOrder.id })
          });
          var data = await res.json();

          if (res.ok && data.success) {
            alert(data.message || 'Alterações aprovadas com sucesso! A RSTK foi notificada para providenciar o despacho.');
            await loadOrders();
          } else {
            alert(data.error || 'Erro ao aprovar alterações.');
            modalApproveBtn.disabled = false;
            modalApproveBtn.innerHTML = '<span>✓ Confirmar Alterações</span>';
          }
        } catch (err) {
          alert('Erro de conexão ao aprovar alterações. Tente novamente.');
          modalApproveBtn.disabled = false;
          modalApproveBtn.innerHTML = '<span>✓ Confirmar Alterações</span>';
        }
      });

      function checkPendingCart() {
        var banner = document.getElementById('pending-cart-banner');
        var titleEl = document.getElementById('pending-cart-title');
        if (!banner) return;
        try {
          var raw = localStorage.getItem('rstk-selection');
          var items = raw ? JSON.parse(raw) : [];
          if (Array.isArray(items) && items.length > 0) {
            var count = items.length;
            if (titleEl) {
              titleEl.textContent = 'Você possui ' + count + ' vinil(is) no carrinho prontos para envio!';
            }
            banner.hidden = false;
            banner.style.display = 'flex';
            return;
          }
        } catch (e) {}
        banner.hidden = true;
        banner.style.display = 'none';
      }

      var btnResend = document.getElementById('btn-resend-verification');
      if (btnResend) {
        btnResend.addEventListener('click', async function () {
          btnResend.disabled = true;
          btnResend.textContent = 'Enviando...';
          try {
            var res = await fetch('/api/client/resend-verification', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email: clientData ? clientData.email : '' })
            });
            var data = await res.json();
            if (res.ok && data.success) {
              alert(data.message || 'E-mail de confirmação reenviado com sucesso! Verifique sua caixa de entrada.');
              btnResend.textContent = 'E-mail Reenviado ✓';
            } else {
              alert(data.error || 'Erro ao reenviar e-mail.');
              btnResend.disabled = false;
              btnResend.textContent = 'Reenviar E-mail';
            }
          } catch (e) {
            alert('Erro de conexão ao reenviar e-mail.');
            btnResend.disabled = false;
            btnResend.textContent = 'Reenviar E-mail';
          }
        });
      }

      btnLogout.addEventListener('click', async function () {
        if (!confirm('Deseja realmente sair da sua conta?')) return;
        try {
          await fetch('/api/client/logout', { method: 'POST' });
        } catch (e) {}
        window.location.replace('/');
      });

      btnRefresh.addEventListener('click', function () {
        btnRefresh.classList.add('rotating');
        setTimeout(function () {
          btnRefresh.classList.remove('rotating');
        }, 600);
        loadOrders();
        checkPendingCart();
      });

      checkAuth();
      checkPendingCart();
    })();
  </script>

