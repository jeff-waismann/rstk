---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalogData from '../../data/catalog.json';
import siteSettingsData from '../../data/siteSettings.json';
import type { SiteSettings, VinylAlbum } from '../../utils/format';

const allProducts = catalogData as VinylAlbum[];
const siteSettings = {
  ...(siteSettingsData as SiteSettings),
  seoTitle: 'Meus Pedidos & Área do Cliente — RSTK Atacado',
  seoDescription: 'Acompanhe seus pedidos de vinis no atacado, status de aprovação e histórico de compras da sua loja.'
};
---

<BaseLayout
  settings={siteSettings}
  products={allProducts}
  heroCovers={allProducts.slice(0, 3)}
  canonicalPath="/cliente/pedidos"
  noindex={true}
>
  <main class="portal-page">
    <div class="portal-container">
      {/* Top Header do Portal do Cliente */}
      <div class="portal-header">
        <div class="portal-welcome">
          <span class="badge-b2b">Portal da Revenda B2B</span>
          <h1 id="client-company-name">Carregando seus dados...</h1>
          <p id="client-info-sub" class="client-sub">Consultando seus dados cadastrais...</p>
        </div>
        <div class="portal-header-actions">
          <a href="/" class="btn-new-order">
            <span>+ Novo Pedido no Catálogo</span>
          </a>
          <button type="button" id="btn-logout" class="btn-logout-portal">
            Sair
          </button>
        </div>
      </div>

      {/* Banner de Aviso: E-mail não confirmado */}
      <div id="unverified-banner" class="unverified-banner" hidden>
        <div class="unverified-icon">✉</div>
        <div class="unverified-content">
          <strong>Confirmação de e-mail pendente</strong>
          <p>Enviamos um link de confirmação para sua caixa de entrada. Confirme seu e-mail para receber alertas de aprovação de pedidos.</p>
        </div>
      </div>

      <div id="portal-alert" class="alert-box" hidden></div>

      {/* Seção Principal de Pedidos */}
      <div class="portal-content">
        <div class="orders-header">
          <div>
            <h2>Seus Pedidos RSTK</h2>
            <p>Acompanhe o status de faturamento, aprovação e separação dos seus pedidos.</p>
          </div>
          <button type="button" id="btn-refresh-orders" class="btn-refresh">
            ↻ Atualizar
          </button>
        </div>

        <div id="orders-loading" class="orders-loading">
          <div class="spinner"></div>
          <p>Carregando histórico de pedidos...</p>
        </div>

        <div id="orders-empty" class="orders-empty" hidden>
          <div class="empty-icon">📦</div>
          <h3>Nenhum pedido encontrado</h3>
          <p>Sua loja ainda não realizou pedidos vinculados a esta conta. Escolha seus vinis no catálogo e finalize no WhatsApp para que fiquem salvos aqui automaticamente!</p>
          <a href="/" class="btn-primary-portal">Explorar Catálogo de Vinis →</a>
        </div>

        <div id="orders-list" class="orders-list" hidden>
          {/* Inserido dinamicamente via JS */}
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    (function () {
      var clientData = null;
      var alertBox = document.getElementById('portal-alert');
      var ordersContainer = document.getElementById('orders-list');
      var loadingEl = document.getElementById('orders-loading');
      var emptyEl = document.getElementById('orders-empty');
      var companyNameEl = document.getElementById('client-company-name');
      var infoSubEl = document.getElementById('client-info-sub');
      var unverifiedBanner = document.getElementById('unverified-banner');
      var btnLogout = document.getElementById('btn-logout');
      var btnRefresh = document.getElementById('btn-refresh-orders');

      function formatBRL(cents) {
        return ((cents || 0) / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      }

      function formatDateTimeBR(dateStr) {
        if (!dateStr) return '—';
        try {
          var d = new Date(dateStr.replace(' ', 'T') + (dateStr.includes('Z') ? '' : 'Z'));
          return d.toLocaleString('pt-BR', {
            timeZone: 'America/Sao_Paulo',
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
        } catch (e) {
          return dateStr;
        }
      }

      var STATUS_MAP = {
        whatsapp_aberto: {
          label: 'Aberto / Em Análise',
          badgeClass: 'badge-status-open',
          desc: 'Seu pedido foi registrado e está sendo verificado pela equipe RSTK.'
        },
        confirmado: {
          label: 'Aprovado / Em Separação',
          badgeClass: 'badge-status-confirmed',
          desc: 'Pedido aprovado! Itens em separação no estoque para envio.'
        },
        aprovado: {
          label: 'Aprovado',
          badgeClass: 'badge-status-confirmed',
          desc: 'Pedido aprovado pela equipe RSTK.'
        },
        concluido: {
          label: 'Concluído / Enviado',
          badgeClass: 'badge-status-completed',
          desc: 'Pedido faturado e entregue/enviado com sucesso.'
        },
        cancelado: {
          label: 'Cancelado',
          badgeClass: 'badge-status-cancelled',
          desc: 'Pedido cancelado.'
        }
      };

      async function checkAuth() {
        try {
          var res = await fetch('/api/client/me', { cache: 'no-store' });
          var data = await res.json();
          if (!res.ok || !data.loggedIn) {
            window.location.replace('/cliente/login');
            return;
          }
          clientData = data.client;
          renderClientHeader();
          loadOrders();
        } catch (err) {
          window.location.replace('/cliente/login');
        }
      }

      function renderClientHeader() {
        if (!clientData) return;
        var displayName = clientData.nomeFantasia || clientData.razaoSocial;
        companyNameEl.textContent = displayName;
        infoSubEl.textContent = 'CNPJ: ' + clientData.cnpj + ' · Responsável: ' + clientData.responsavelNome + ' (' + clientData.email + ')';

        if (!clientData.emailVerified) {
          unverifiedBanner.hidden = false;
        } else {
          unverifiedBanner.hidden = true;
        }
      }

      async function loadOrders() {
        loadingEl.hidden = false;
        emptyEl.hidden = true;
        ordersContainer.hidden = true;

        try {
          var res = await fetch('/api/client/orders', { cache: 'no-store' });
          var data = await res.json();

          loadingEl.hidden = true;

          if (res.ok && data.success && Array.isArray(data.orders)) {
            if (data.orders.length === 0) {
              emptyEl.hidden = false;
            } else {
              renderOrders(data.orders);
              ordersContainer.hidden = false;
            }
          } else {
            emptyEl.hidden = false;
          }
        } catch (err) {
          loadingEl.hidden = true;
          emptyEl.hidden = false;
        }
      }

      function renderOrders(orders) {
        ordersContainer.innerHTML = '';

        orders.forEach(function (order) {
          var statusInfo = STATUS_MAP[order.status] || STATUS_MAP.whatsapp_aberto;
          var card = document.createElement('article');
          card.className = 'order-card';

          var hasChanges = Boolean(order.changes || (order.adminNotes && order.adminNotes.trim()));
          var isApproved = Boolean(order.approvedAt || order.status === 'aprovado' || order.status === 'confirmado');

          var itemsHtml = (order.items || []).map(function (it) {
            return `
              <div class="order-item-row">
                <img src="${it.cover || '/assets/covers/album-01.webp'}" alt="" class="order-item-img" />
                <div class="order-item-info">
                  <strong>${it.title || 'Disco de Vinil'}</strong>
                  <span>${it.artist || 'Artista'} · ${Number(it.units) === 1 ? 'Álbum Simples' : (Number(it.units) === 2 ? 'Álbum Duplo' : `${it.units || 1} LPs`)}</span>
                </div>
                <div class="order-item-qty">
                  <span class="qty-badge">${it.quantity} un.</span>
                </div>
                <div class="order-item-price">
                  <span>${formatBRL(it.priceCents)} un.</span>
                  <strong>${formatBRL((it.priceCents || 18999) * (it.quantity || 1))}</strong>
                </div>
              </div>
            `;
          }).join('');

          var whatsappSupportUrl = 'https://wa.me/553488293565?text=' + encodeURIComponent(
            'Olá, RSTK! Gostaria de falar sobre o pedido #' + order.orderNumber + ' da minha loja (' + (clientData.nomeFantasia || clientData.razaoSocial) + ').'
          );

          card.innerHTML = `
            <div class="order-card-header">
              <div class="order-header-left">
                <div class="order-num-date">
                  <span class="order-id">#${order.orderNumber}</span>
                  <span class="order-date">${formatDateTimeBR(order.createdAt)}</span>
                </div>
                <span class="badge-status ${statusInfo.badgeClass}">
                  ${statusInfo.label}
                </span>
              </div>
              <div class="order-header-right">
                <span class="total-label">Total do Pedido:</span>
                <span class="total-value">${formatBRL(order.totalCents)}</span>
              </div>
            </div>

            ${isApproved ? `
              <div class="alert-approved">
                <span class="alert-approved-icon">✓</span>
                <div>
                  <strong>Pedido Aprovado pela RSTK!</strong>
                  <p>Aprovado em ${formatDateTimeBR(order.approvedAt || order.updatedAt)}. Seus vinis estão em processo de separação e expedição.</p>
                </div>
              </div>
            ` : ''}

            ${hasChanges ? `
              <div class="alert-order-changes">
                <span class="alert-changes-icon">⚠</span>
                <div>
                  <strong>Atenção: Este pedido teve ajustes realizados pela equipe RSTK</strong>
                  <p>Houve alterações na composição do pedido (ex: item esgotado ou ajuste de unidades disponíveis). O valor total atualizado é <strong>${formatBRL(order.totalCents)}</strong>.</p>
                  ${order.adminNotes ? `<p class="admin-note-text"><em>Observação do lojista: "${order.adminNotes}"</em></p>` : ''}
                </div>
              </div>
            ` : ''}

            <div class="order-items-wrapper">
              <span class="items-count-label">${order.itemCount} vinil(is) no pedido:</span>
              <div class="order-items-list">
                ${itemsHtml}
              </div>
            </div>

            <div class="order-card-footer">
              <a href="${whatsappSupportUrl}" target="_blank" rel="noopener noreferrer" class="btn-order-support">
                <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span>Falar com Atendimento sobre o Pedido #${order.orderNumber}</span>
              </a>
            </div>
          `;

          ordersContainer.appendChild(card);
        });
      }

      btnLogout.addEventListener('click', async function () {
        if (!confirm('Deseja realmente sair da sua conta?')) return;
        try {
          await fetch('/api/client/logout', { method: 'POST' });
        } catch (e) {}
        window.location.replace('/');
      });

      btnRefresh.addEventListener('click', function () {
        loadOrders();
      });

      checkAuth();
    })();
  </script>

  <style>
    .portal-page {
      min-height: calc(100vh - 120px);
      padding: 36px 16px 80px;
      display: flex;
      justify-content: center;
      background: var(--bg);
    }

    .portal-container {
      width: 100%;
      max-width: 900px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Header */
    .portal-header {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 24px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    }

    .badge-b2b {
      display: inline-block;
      background: rgba(0, 198, 247, 0.15);
      color: var(--blue-dark);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 3px 10px;
      border-radius: 999px;
      margin-bottom: 6px;
    }

    .portal-welcome h1 {
      font-size: 22px;
      font-weight: 850;
      color: var(--ink);
      margin: 0 0 4px;
    }

    .client-sub {
      font-size: 13px;
      color: var(--muted);
      margin: 0;
    }

    .portal-header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-new-order {
      background: var(--blue);
      color: #ffffff;
      font-size: 13px;
      font-weight: 750;
      padding: 10px 18px;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0, 103, 130, 0.2);
    }

    .btn-new-order:hover {
      background: var(--blue-dark);
      transform: translateY(-1px);
    }

    .btn-logout-portal {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
      padding: 9px 16px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-logout-portal:hover {
      border-color: #F75656;
      color: #F75656;
      background: rgba(247, 86, 86, 0.05);
    }

    /* Unverified Banner */
    .unverified-banner {
      background: #FEF3C7;
      border: 1px solid #F59E0B;
      color: #92400E;
      border-radius: 12px;
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px;
    }

    .unverified-icon {
      font-size: 20px;
      flex-shrink: 0;
    }

    .unverified-content strong {
      display: block;
      margin-bottom: 2px;
    }

    .unverified-content p {
      margin: 0;
    }

    /* Orders Section */
    .portal-content {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .orders-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .orders-header h2 {
      font-size: 18px;
      font-weight: 800;
      color: var(--ink);
      margin: 0 0 2px;
    }

    .orders-header p {
      font-size: 13px;
      color: var(--muted);
      margin: 0;
    }

    .btn-refresh {
      background: var(--panel);
      border: 1px solid var(--line);
      color: var(--ink);
      font-size: 12px;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-refresh:hover {
      border-color: var(--blue);
      color: var(--blue);
    }

    /* Loading & Empty */
    .orders-loading,
    .orders-empty {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 48px 24px;
      text-align: center;
    }

    .empty-icon {
      font-size: 40px;
      margin-bottom: 12px;
    }

    .orders-empty h3 {
      font-size: 18px;
      color: var(--ink);
      margin: 0 0 6px;
    }

    .orders-empty p {
      font-size: 13.5px;
      color: var(--muted);
      max-width: 480px;
      margin: 0 auto 20px;
      line-height: 1.5;
    }

    .btn-primary-portal {
      display: inline-block;
      background: var(--blue);
      color: #ffffff;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 750;
      text-decoration: none;
    }

    .spinner {
      width: 32px;
      height: 32px;
      border: 3px solid var(--line);
      border-top-color: var(--blue);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 12px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Orders Cards */
    .orders-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .order-card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
    }

    .order-card-header {
      background: var(--panel2);
      border-bottom: 1px solid var(--line);
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .order-header-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .order-num-date {
      display: flex;
      flex-direction: column;
    }

    .order-id {
      font-size: 15px;
      font-weight: 800;
      font-family: monospace;
      color: var(--ink);
    }

    .order-date {
      font-size: 11.5px;
      color: var(--muted);
    }

    .badge-status {
      font-size: 11px;
      font-weight: 750;
      padding: 4px 10px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .badge-status-open {
      background: #E0F2FE;
      color: #0369A1;
      border: 1px solid #BAE6FD;
    }

    .badge-status-confirmed {
      background: #DCFCE7;
      color: #15803D;
      border: 1px solid #86EFAC;
    }

    .badge-status-completed {
      background: #F1F5F9;
      color: #334155;
      border: 1px solid #CBD5E1;
    }

    .badge-status-cancelled {
      background: #FEE2E2;
      color: #B91C1C;
      border: 1px solid #FCA5A5;
    }

    .order-header-right {
      text-align: right;
    }

    .total-label {
      font-size: 11px;
      color: var(--muted);
      display: block;
    }

    .total-value {
      font-size: 17px;
      font-weight: 850;
      color: var(--blue);
    }

    /* Approved Alert */
    .alert-approved {
      background: #F0FDF4;
      border-left: 4px solid #22C55E;
      padding: 14px 20px;
      display: flex;
      gap: 12px;
      font-size: 13px;
      color: #14532D;
    }

    .alert-approved-icon {
      font-size: 18px;
      font-weight: 800;
      color: #16A34A;
    }

    .alert-approved strong {
      display: block;
      margin-bottom: 2px;
    }

    .alert-approved p {
      margin: 0;
      font-size: 12.5px;
    }

    /* Changes Alert */
    .alert-order-changes {
      background: #FFFBEB;
      border-left: 4px solid #F59E0B;
      padding: 14px 20px;
      display: flex;
      gap: 12px;
      font-size: 13px;
      color: #78350F;
    }

    .alert-changes-icon {
      font-size: 18px;
      color: #D97706;
    }

    .alert-order-changes strong {
      display: block;
      margin-bottom: 2px;
    }

    .alert-order-changes p {
      margin: 0;
      font-size: 12.5px;
    }

    .admin-note-text {
      margin-top: 4px !important;
      color: #92400E;
    }

    /* Items */
    .order-items-wrapper {
      padding: 16px 20px;
    }

    .items-count-label {
      font-size: 11px;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--muted);
      display: block;
      margin-bottom: 12px;
    }

    .order-items-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .order-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 12px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    .order-item-img {
      width: 44px;
      height: 44px;
      border-radius: 6px;
      object-fit: cover;
      flex-shrink: 0;
      border: 1px solid var(--line);
    }

    .order-item-info {
      flex: 1;
      min-width: 0;
    }

    .order-item-info strong {
      display: block;
      font-size: 13px;
      color: var(--ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .order-item-info span {
      font-size: 11px;
      color: var(--muted);
    }

    .qty-badge {
      background: var(--panel2);
      border: 1px solid var(--line);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      color: var(--ink);
    }

    .order-item-price {
      text-align: right;
      flex-shrink: 0;
    }

    .order-item-price span {
      display: block;
      font-size: 10.5px;
      color: var(--muted);
    }

    .order-item-price strong {
      font-size: 13px;
      color: var(--blue);
    }

    /* Footer */
    .order-card-footer {
      background: var(--panel2);
      border-top: 1px solid var(--line);
      padding: 12px 20px;
      display: flex;
      justify-content: flex-end;
    }

    .btn-order-support {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: transparent;
      border: 1px solid #25D366;
      color: #128C7E;
      font-size: 12px;
      font-weight: 700;
      padding: 7px 14px;
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-order-support:hover {
      background: #25D366;
      color: #ffffff;
    }

    .w-4 {
      width: 16px;
      height: 16px;
    }

    @media (max-width: 600px) {
      .portal-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .portal-header-actions {
        width: 100%;
        justify-content: space-between;
      }
      .order-card-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .order-header-right {
        text-align: left;
      }
    }
  </style>
</BaseLayout>
